---
import { WEB_URL, WEB_HOST } from "../consts";

// The demo document: each line is typed with its Markdown markers showing,
// and the markers disappear once the caret leaves the line, as in the editor.
// `m` = a marker, `b` = bold text, plain strings are text.
type Piece = string | { m: string } | { b: string };
const LINES: { kind: "h1" | "task" | "p"; pieces: Piece[] }[] = [
  { kind: "h1", pieces: [{ m: "# " }, "Trip notes"] },
  { kind: "task", pieces: [{ m: "- [x] " }, "Book the train to Mysuru"] },
  { kind: "task", pieces: [{ m: "- [ ] " }, "Print the hotel booking"] },
  { kind: "p", pieces: ["Pack ", { m: "**" }, { b: "light" }, { m: "**" }, ". The forecast says rain all weekend."] },
];
const text = (p: Piece) => (typeof p === "string" ? p : "m" in p ? p.m : p.b);
---
<figure class="wt-window" aria-label="The Sarala web app turning typed Markdown into a formatted page">
  <div class="wt-bar">
    <span class="wt-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <a class="wt-address" href={WEB_URL} target="_blank" rel="noopener" tabindex="-1">{WEB_HOST}</a>
  </div>
  <div class="wt-doc" id="wt-doc" aria-hidden="true">
    {LINES.map((line) => (
      <p class={`wt-line wt-${line.kind} done`}>
        {line.kind === "task" && <span class={`wt-box${text(line.pieces[0]).includes("x") ? " on" : ""}`}></span>}
        {line.pieces.map((p) =>
          typeof p === "string" ? <span class="wt-t" data-t={p}>{p}</span>
          : "m" in p ? <span class="wt-t wt-mk" data-t={p.m}>{p.m}</span>
          : <strong class="wt-t" data-t={p.b}>{p.b}</strong>
        )}
      </p>
    ))}
  </div>
  <div class="wt-status" aria-hidden="true">
    <span>Markdown</span>
    <span class="wt-saved" id="wt-saved"><i></i>Saved on this device</span>
  </div>
</figure>

<script>
  const doc = document.getElementById("wt-doc");
  const saved = document.getElementById("wt-saved");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Type each line with its markers visible; leaving the line renders it.
  // The finished page is what's in the HTML, so no script or reduced motion
  // still shows it.
  if (doc && saved && !still) {
    const lines = [...doc.querySelectorAll<HTMLElement>(".wt-line")];
    const run = async () => {
      const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
      for (const line of lines) {
        line.classList.remove("done");
        for (const t of line.querySelectorAll<HTMLElement>(".wt-t")) t.textContent = "";
      }
      saved.classList.remove("on");
      const caret = document.createElement("span");
      caret.className = "wt-caret";
      await wait(400);
      for (const line of lines) {
        line.classList.add("typing");
        for (const t of line.querySelectorAll<HTMLElement>(".wt-t")) {
          const full = t.dataset.t ?? "";
          t.after(caret);
          for (let i = 1; i <= full.length; i++) {
            t.textContent = full.slice(0, i);
            await wait(28 + Math.random() * 30);
          }
        }
        await wait(220);
        line.classList.remove("typing");
        line.classList.add("done");
      }
      caret.remove();
      await wait(300);
      saved.classList.add("on");
    };
    const once = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      once.disconnect();
      void run();
    }, { threshold: 0.5 });
    once.observe(doc);
  } else {
    saved?.classList.add("on");
  }
</script>

<style>
  .wt-window {
    margin: 0; overflow: hidden;
    border: 1px solid var(--line-strong); border-radius: 12px; background: var(--paper);
    box-shadow: var(--shadow-canvas);
  }
  .wt-bar { position: relative; display: flex; align-items: center; height: 40px; padding: 0 14px; border-bottom: 1px solid var(--line); background: #f6f1e7; }
  .wt-dots { display: inline-flex; gap: 7px; }
  .wt-dots i { width: 11px; height: 11px; border-radius: 50%; background: #f0a096; }
  .wt-dots i:nth-child(2) { background: #eec870; }
  .wt-dots i:nth-child(3) { background: #9ec888; }
  .wt-address {
    position: absolute; left: 50%; transform: translateX(-50%); max-width: calc(100% - 120px);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    padding: 4px 14px; border: 1px solid var(--line); border-radius: 7px; background: var(--paper);
    color: var(--muted); font-size: 12.5px; text-decoration: none;
  }
  .wt-address:hover { color: var(--ink); }

  /* The page: the editor's own measure and type (Inter, 16px base). */
  .wt-doc {
    padding: clamp(28px, 4vw, 44px) clamp(24px, 5vw, 52px) clamp(28px, 4vw, 40px);
    font: 400 16px/1.6 Inter, system-ui, sans-serif; color: #2b2620; background: #f9f5ee;
  }
  .wt-line { margin: 0; min-height: 1.6em; }
  .wt-h1 { margin-bottom: 14px; font-size: 30px; font-weight: 700; line-height: 1.25; letter-spacing: -.02em; min-height: 1.25em; }
  .wt-task { display: flex; align-items: baseline; gap: 7px; line-height: 2; min-height: 2em; }
  .wt-task + .wt-p { margin-top: 12px; }
  .wt-p strong { font-weight: 700; }

  /* Markers show while the line is being typed and vanish once it's done. */
  .wt-mk { color: var(--terra); opacity: .7; }
  .wt-line.done .wt-mk { display: none; }
  .wt-box { display: none; flex: none; position: relative; top: 1px; width: 13px; height: 13px; border: 1px solid #686155; border-radius: 3px; }
  .wt-box.on { background: var(--terra); border-color: var(--terra); }
  .wt-box.on::after {
    content: ""; position: absolute; left: 3.5px; top: 1px; width: 3.5px; height: 7px;
    border: solid #fff8f2; border-width: 0 2px 2px 0; transform: rotate(45deg);
  }
  .wt-line.done .wt-box { display: inline-block; }

  .wt-caret { display: inline-block; width: 2px; height: 1.05em; margin-left: 1px; vertical-align: -.15em; background: var(--terra); animation: wt-blink 1s steps(2) infinite; }
  @keyframes wt-blink { 50% { opacity: 0; } }

  .wt-status { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 8px 16px; border-top: 1px solid var(--line); background: #f9f5ee; font-size: 12px; color: var(--muted); }
  .wt-saved { display: inline-flex; align-items: center; gap: 7px; opacity: 0; transition: opacity .4s ease; }
  .wt-saved.on { opacity: 1; }
  .wt-saved i { width: 7px; height: 7px; border-radius: 50%; background: var(--green); }

  @media (max-width: 520px) {
    .wt-h1 { font-size: 26px; }
    .wt-p { min-height: 3.2em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wt-caret { animation: none; }
    .wt-saved { transition: none; }
  }
</style>
