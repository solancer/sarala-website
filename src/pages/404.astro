---
import Layout from "../layouts/Layout.astro";
import Plane from "../components/Plane.astro";
---

<Layout title="Page not found · Sarala" description="This page doesn't exist." path="/404" noindex>
  <main id="main" class="sec" style="border-top:0">
    <div class="frame">
      <div class="bar"><span class="num">404</span><span>Not found</span></div>
      <div class="closing" style="min-height:70vh">
        <Plane variant="closing" />
        <div class="sel">
          <span class="hd" aria-hidden="true"></span><span class="hd" aria-hidden="true"></span><span class="hd" aria-hidden="true"></span><span class="hd" aria-hidden="true"></span>
          <h1 class="h2"><span>this page doesn't exist.</span><span class="b">the link may be old or mistyped.</span></h1>
        </div>
        <p style="position:relative;margin-top:56px"><a class="btn btn-dark" href="/">go to the sarala home page</a></p>
      </div>
    </div>
  </main>
</Layout>
