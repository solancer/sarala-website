    <!-- ============ WHY ============ -->
    <section class="section alt" aria-labelledby="why-title">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="kicker">Why Sarala</span>
          <h2 id="why-title">Write in Markdown. Read a finished document.</h2>
        </div>
        <div class="pillars reveal" data-stagger>
          <div class="pillar">
            <span class="pi" set:html={svg("eye")} />
            <h3>One page, not two</h3>
            <p>Formatting appears the moment you type it. Click any block to edit its Markdown, click away to see it rendered.</p>
          </div>
          <div class="pillar">
            <span class="pi" set:html={svg("hdd")} />
            <h3>Your files, on your disk</h3>
            <p>Documents are plain .md files in folders you choose. No database, no proprietary format, no lock-in.</p>
          </div>
          <div class="pillar">
            <span class="pi" set:html={svg("shield")} />
            <h3>Private by default</h3>
            <p>No account and no telemetry. Voice typing runs offline, and the AI assistant only edits with your approval.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SHOWCASE ============ -->
    <section class="section" id="features" aria-labelledby="showcase-title">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="kicker">Rich content</span>
          <h2 id="showcase-title">Diagrams, math, code and tables, right in the page</h2>
          <p>Type the Markdown you already know. Sarala renders it inline, so a technical document looks finished while you write it.</p>
        </div>

        <div class="reveal">
          <div class="tabs" role="tablist" aria-label="Rich content examples">
            {SHOWCASE.map((s, i) => (
              <button type="button" class="tab" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
                <Fragment set:html={svg(s.icon)} />{s.label}
              </button>
            ))}
          </div>
          {SHOWCASE.map((s, i) => (
            <div class="panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
              <figure class="shot">
                <button type="button" data-zoom aria-label={`Enlarge screenshot: ${s.title}`}>
                  <img src={`/screenshots/shots/${s.img}.webp`} alt={s.alt} width="1680" height="1125" loading={i === 0 ? "eager" : "lazy"} decoding="async" />
                </button>
              </figure>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
                <p class="you-type">You type<code>{s.code}</code></p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ AI ASSISTANT ============ -->
    <section class="section alt" id="ai" aria-labelledby="ai-title">
      <div class="wrap split">
        <div class="split-text reveal">
          <div class="sec-head">
            <span class="kicker">AI assistant</span>
            <h2 id="ai-title">AI that edits only with your approval</h2>
            <p>Ask an AI agent to review, summarise or rewrite your document. Every change arrives as a diff you accept or reject, and undo works as usual.</p>
          </div>
          <ul class="checks">
            <li><span class="ck" set:html={svg("check")} /><div><h3>Every edit is a proposal</h3><p>Word-level diffs with Accept and Reject on each change, or accept them all at once.</p></div></li>
            <li><span class="ck" set:html={svg("check")} /><div><h3>No API keys, no account</h3><p>Sarala runs the agent already installed on your computer, with its own sign-in.</p></div></li>
            <li><span class="ck" set:html={svg("check")} /><div><h3>Your file stays untouched</h3><p>The agent works on a scratch copy. Nothing changes until you accept it.</p></div></li>
          </ul>
          <div class="badge-row" aria-label="Supported agents"><span class="badge">Claude Code</span><span class="badge">OpenAI Codex</span><span class="badge">GitHub Copilot CLI</span></div>
        </div>
        <figure class="shot reveal">
          <button type="button" data-zoom aria-label="Enlarge screenshot: the AI assistant proposing edits">
            <img src="/screenshots/shots/ai-assistant.webp" alt="The AI assistant proposing two edits to a Kubernetes runbook in Sarala, shown as diffs with Accept and Reject buttons" width="1680" height="1125" loading="lazy" decoding="async" />
          </button>
          <figcaption>Proposed changes appear as diffs, block by block.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ============ VOICE ============ -->
    <section class="section" id="voice" aria-labelledby="voice-title">
      <div class="wrap split rev">
        <div class="split-text reveal">
          <div class="sec-head">
            <span class="kicker">Voice typing</span>
            <h2 id="voice-title">Speak, and Sarala types. Fully offline.</h2>
            <p>Hold a shortcut and talk. Speech becomes text on your own computer using an open model you download once, so nothing is uploaded.</p>
          </div>
          <ul class="checks">
            <li><span class="ck" set:html={svg("check")} /><div><h3>Push to talk or tap to toggle</h3><p>A small pill shows the level and timer while you speak.</p></div></li>
            <li><span class="ck" set:html={svg("check")} /><div><h3>Hands-free commands</h3><p>Say “new paragraph”, “scratch that” or “bold that” to edit without the keyboard.</p></div></li>
            <li><span class="ck" set:html={svg("check")} /><div><h3>Ready in a minute</h3><p>Pick a language, check your microphone, choose a shortcut, and try it.</p></div></li>
          </ul>
        </div>
        <figure class="shot reveal">
          <button type="button" data-zoom aria-label="Enlarge screenshot: voice typing">
            <img src="/screenshots/shots/voice-typing.webp" alt="Voice typing in Sarala: a recording pill with a live waveform while words appear in the document" width="1680" height="1125" loading="lazy" decoding="async" />
          </button>
          <figcaption>Words appear as you speak, with no internet connection needed.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ============ FEATURE GRID ============ -->
    <section class="section alt" aria-labelledby="more-title">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="kicker">And more</span>
          <h2 id="more-title">Built for long writing sessions</h2>
        </div>
        <div class="fgrid reveal" data-stagger>
