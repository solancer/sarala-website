---
import Layout from "../layouts/Layout.astro";
import VoicePill from "../components/VoicePill.astro";
import { VERSION, GITHUB, RELEASES, SNAP, DL, BUILDS, ALT, ALT_SIZE, MAC_APP_PATH } from "../consts";

const LICENSE = `${GITHUB}/blob/main/LICENSE`;
const ISSUES = `${GITHUB}/issues`;
const CONTRIBUTING = `${GITHUB}/blob/main/CONTRIBUTING.md`;
const QUARANTINE_CMD = `xattr -dr com.apple.quarantine ${MAC_APP_PATH}`;
const BREW_CMDS = [
  `brew tap solancer/sarala ${GITHUB}`,
  "brew trust --cask solancer/sarala/sarala",
  "brew install --cask --yes sarala",
];

/** Lucide-style icons (24px grid, stroke) used across the page. */
const I = {
  download: '<path d="M12 3v12"/><path d="m7 11 5 5 5-5"/><path d="M5 21h14"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  file: '<path d="M6 2h9l5 5v15H6z"/><path d="M15 2v5h5"/>',
  folder: '<path d="M3 6.5A1.5 1.5 0 0 1 4.5 5H9l2 2.5h8.5A1.5 1.5 0 0 1 21 9v9.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5z"/>',
  chevR: '<path d="m9 6 6 6-6 6"/>',
  chevD: '<path d="m6 9 6 6 6-6"/>',
  files: '<path d="M15 2H8a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z"/><path d="M15 2v5h5"/><path d="M4 7v13a2 2 0 0 0 2 2h10"/>',
  outline: '<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  trash: '<path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/>',
  refresh: '<path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 4v7h-7"/>',
  collapse: '<path d="m7 20 5-5 5 5M7 4l5 5 5-5"/>',
  newfile: '<path d="M14 2H6v20h12V6z"/><path d="M12 11v6M9 14h6"/>',
  openfolder: '<path d="M3 7.5V18a2 2 0 0 0 2 2h14l2-8H7l-2 8"/><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6H9l2 2h6.5A1.5 1.5 0 0 1 19 9.5V12"/>',
  sidebar: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  mic: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>',
  focus: '<path d="M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16"/><circle cx="12" cy="12" r="2.5"/>',
  sparkle: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>',
  hdd: '<path d="M4 6h16v12H4z"/><path d="M8 14h.01M12 14h4"/>',
  shield: '<path d="M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6z"/><path d="m9 12 2 2 4-4"/>',
  diagram: '<rect x="3" y="3" width="7" height="6" rx="1.5"/><rect x="14" y="15" width="7" height="6" rx="1.5"/><path d="M6.5 9v3.5a2 2 0 0 0 2 2H14"/>',
  sigma: '<path d="M18 7V4H6l6 8-6 8h12v-3"/>',
  code: '<path d="m8 6-6 6 6 6M16 6l6 6-6 6"/>',
  table: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16"/>',
  command: '<path d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3"/>',
  tree: '<path d="M4 4h6v5H4zM14 15h6v5h-6zM14 4h6v5h-6z"/><path d="M7 9v8.5h7M10 6.5h4"/>',
  tabs: '<path d="M3 8h18v12H3z"/><path d="M3 8V5a1 1 0 0 1 1-1h6l2 4"/>',
  eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  exportIcon: '<path d="M12 15V3"/><path d="m7 8 5-5 5 5"/><path d="M5 14v6h14v-6"/>',
  image: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 17-5-5-9 8"/>',
  md: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M6 15V9l3 3 3-3v6M17 9v6m-2-2 2 2 2-2"/>',
  update: '<path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/>',
  keyboard: '<rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10"/>',
  github: '<path fill="currentColor" stroke="none" d="M12 1.5a10.5 10.5 0 0 0-3.32 20.46c.52.1.71-.23.71-.5v-1.77c-2.9.63-3.52-1.4-3.52-1.4-.47-1.2-1.16-1.52-1.16-1.52-.95-.65.07-.64.07-.64 1.05.08 1.6 1.08 1.6 1.08.93 1.6 2.45 1.14 3.05.87.1-.68.36-1.14.66-1.4-2.32-.27-4.76-1.16-4.76-5.16 0-1.14.4-2.07 1.07-2.8-.1-.27-.46-1.33.1-2.76 0 0 .88-.28 2.88 1.07a9.9 9.9 0 0 1 5.24 0c2-1.35 2.87-1.07 2.87-1.07.57 1.43.21 2.49.1 2.76.67.73 1.07 1.66 1.07 2.8 0 4.01-2.45 4.89-4.78 5.15.38.32.71.95.71 1.92v2.85c0 .28.19.61.72.5A10.5 10.5 0 0 0 12 1.5Z"/>',
  heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"/>',
};
const svg = (name: keyof typeof I, cls = "", style = "") =>
  `<svg${cls ? ` class="${cls}"` : ""}${style ? ` style="${style}"` : ""} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${I[name]}</svg>`;

/** Rich content, one tab each. `code` is what you'd type to get the screenshot. */
const SHOWCASE = [
  {
    id: "diagrams", label: "Diagrams", icon: "diagram" as const, img: "diagrams",
    alt: "A Mermaid flowchart of a Kubernetes request path, rendered inline in a Sarala document",
    title: "Mermaid and D2 diagrams",
    text: "Flowcharts, sequence diagrams and architecture maps render right in the page and follow your theme. Click a diagram to edit its source.",
    code: "<span class=\"c-f\">```</span><span class=\"c-l\">mermaid</span>\nflowchart LR\n  user <span class=\"c-o\">--></span> ingress <span class=\"c-o\">--></span> service\n<span class=\"c-f\">```</span>",
  },
  {
    id: "math", label: "Math", icon: "sigma" as const, img: "math",
    alt: "Queueing-theory equations typeset with KaTeX in Sarala",
    title: "LaTeX math, typeset as you write",
    text: "Inline and display equations render with KaTeX, with optional equation numbering and references.",
    code: "<span class=\"c-f\">$$</span>\nW = <span class=\"c-k\">\\frac</span>{1}{<span class=\"c-k\">\\mu</span> - <span class=\"c-k\">\\lambda</span>}\n<span class=\"c-f\">$$</span>",
  },
  {
    id: "code", label: "Code", icon: "code" as const, img: "code",
    alt: "A syntax-highlighted Java Kafka producer in Sarala's Night theme, with the document outline beside it",
    title: "Code blocks with real highlighting",
    text: "Fenced code is highlighted for more than 100 languages, using colours from your theme.",
    code: "<span class=\"c-f\">```</span><span class=\"c-l\">java</span>\nproducer.<span class=\"c-k\">send</span>(record);\n<span class=\"c-f\">```</span>",
  },
  {
    id: "tables", label: "Tables & tasks", icon: "table" as const, img: "tables",
    alt: "A settings table, a rollout checklist and a warning callout in Sarala's GitHub theme",
    title: "Tables, task lists and callouts",
    text: "Edit tables cell by cell, tick tasks with a click, and use GitHub-style callouts for notes and warnings.",
    code: "<span class=\"c-o\">|</span> Setting <span class=\"c-o\">|</span> Value <span class=\"c-o\">|</span>\n<span class=\"c-o\">| :-- | --: |</span>\n<span class=\"c-f\">- [x]</span> Readiness probe\n<span class=\"c-f\">&gt;</span> <span class=\"c-l\">[!WARNING]</span>",
  },

];


const THEMES = [
  { id: "paper", dot: "#f3eee3", name: "Sarala", sub: "Warm parchment, light", bg: "#f3eee3", border: "#e4dccb", fg: "#2b2620", accent: "#9a4b28", on: "#fff8f2", sw: ["#a7402d", "#8b5629", "#785e18", "#3e6d41", "#33697c", "#735496"] },
  { id: "pro", dot: "#ff6188", name: "Pro", sub: "Warm dark", bg: "#2d2a2e", border: "#403e41", fg: "#fcfcfa", accent: "#ff6188", on: "#2d2a2e", sw: ["#ff6188", "#fc9867", "#ffd866", "#a9dc76", "#78dce8", "#ab9df2"] },
  { id: "classic", dot: "#a6e22e", name: "Classic", sub: "The original dark", bg: "#272822", border: "#3b3a32", fg: "#fdfff1", accent: "#f92672", on: "#272822", sw: ["#f92672", "#fd971f", "#e6db74", "#a6e22e", "#66d9ef", "#ae81ff"] },
  { id: "octagon", dot: "#9cd1bb", name: "Octagon", sub: "Cool indigo", bg: "#282a3a", border: "#3a3d4b", fg: "#eaf2f1", accent: "#ff657a", on: "#282a3a", sw: ["#ff657a", "#ff9b5e", "#ffd76d", "#bad761", "#9cd1bb", "#c39ac9"] },
  { id: "machine", dot: "#7cd5f1", name: "Machine", sub: "Teal graphite", bg: "#273136", border: "#3a464b", fg: "#f2fffc", accent: "#ff6d7e", on: "#273136", sw: ["#ff6d7e", "#ffb270", "#ffed72", "#a2e57b", "#7cd5f1", "#baa0f8"] },
  { id: "ristretto", dot: "#f9cc6c", name: "Ristretto", sub: "Espresso brown", bg: "#2c2525", border: "#403838", fg: "#fff1f3", accent: "#fd6883", on: "#2c2525", sw: ["#fd6883", "#f38d70", "#f9cc6c", "#adda78", "#85dacc", "#a8a9eb"] },
  { id: "spectrum", dot: "#948ae3", name: "Spectrum", sub: "Neutral black", bg: "#222222", border: "#363636", fg: "#f7f1ff", accent: "#fc618d", on: "#222222", sw: ["#fc618d", "#fd9353", "#fce566", "#7bd88f", "#5ad4e6", "#948ae3"] },
];

const OS_ICON = {
  mac: '<path fill="currentColor" stroke="none" d="M16.7 2.8c.1 1-.3 2-1 2.8-.7.8-1.7 1.4-2.7 1.3-.1-1 .4-2 1-2.7.7-.8 1.8-1.3 2.7-1.4ZM19 17c-.5 1.2-.8 1.7-1.5 2.7-1 1.4-2.4 3.1-4.1 3.1-1.5 0-1.9-1-3.9-1-2 0-2.5 1-4 1-1.7 0-3-1.6-4-3C-.3 16.6-.6 11 1.7 8.3c1-1.3 2.6-2.1 4.1-2.1 1.6 0 2.6 1 3.9 1 1.3 0 2-1 3.9-1 1.4 0 2.9.8 3.9 2.1-3.4 1.9-2.9 6.8 1.6 8.7Z"/>',
  win: '<path fill="currentColor" stroke="none" d="M3 3.9 10.5 2.9v8.1H3V3.9ZM11.5 2.8 21 1.5V11H11.5V2.8ZM3 12.9h7.5V21L3 20V12.9ZM11.5 13H21v9.5L11.5 21.2V13Z"/>',
  linux: '<path fill="currentColor" stroke="none" d="M12 2c-2.2 0-3.4 1.8-3.4 4.1 0 1.4.4 2.4-.4 3.6-.9 1.3-2.9 3.6-2.9 6.4 0 .9.2 1.7.6 2.4-.8.4-1.7.8-1.7 1.6 0 1 1.7 1.3 3.3 1.6 1.2.2 2 .6 3 .6 1.1 0 1.6-.7 2-.7s1 .7 2 .7c1 0 1.9-.4 3.1-.6 1.6-.3 3.2-.6 3.2-1.6 0-.8-.9-1.2-1.7-1.6.4-.7.6-1.5.6-2.4 0-2.8-2-5.1-2.9-6.4-.8-1.2-.4-2.2-.4-3.6C15.4 3.8 14.2 2 12 2Z"/>',
};
const osSvg = (k: keyof typeof OS_ICON) => `<svg viewBox="0 0 24 24" aria-hidden="true">${OS_ICON[k]}</svg>`;

/** One card per platform; the visitor's own is highlighted by app.js. */
const PLATFORMS = [
  {
    key: "mac" as const, label: "macOS", req: "Apple Silicon and Intel · macOS 10.15 or later",
    cta: "Download .dmg", build: BUILDS.mac,
    alts: [{ label: "Install with Homebrew", href: "#help-mac", note: "" }],
  },
  {
    key: "win" as const, label: "Windows", req: "Windows 10 and 11 · 64-bit",
    cta: "Download installer", build: BUILDS.win,
    alts: [{ label: ".msi", href: `${DL}/${ALT.msi}`, note: ALT_SIZE.msi }],
  },
  {
    key: "linux" as const, label: "Linux", req: "64-bit · Ubuntu, Debian, Fedora and more",
    cta: "Download .deb", build: { file: ALT.deb, size: ALT_SIZE.deb },
    alts: [
      { label: "AppImage", href: `${DL}/${BUILDS.linux.file}`, note: BUILDS.linux.size },
      { label: ".rpm", href: `${DL}/${ALT.rpm}`, note: ALT_SIZE.rpm },
      { label: "Snap", href: SNAP, note: "" },
    ],
  },
];

/** Linux one-liners, per package format. */
const LINUX_CMDS = [
  { id: "lx-deb", label: "Ubuntu, Debian, Mint (.deb)", cmd: `sudo apt install ./${ALT.deb}` },
  { id: "lx-rpm", label: "Fedora, RHEL, openSUSE (.rpm)", cmd: `sudo dnf install ./${ALT.rpm}` },
  { id: "lx-appimage", label: "Any distribution (AppImage)", cmd: `chmod +x ${BUILDS.linux.file} && ./${BUILDS.linux.file}` },
  { id: "lx-snap", label: "Snap Store", cmd: "sudo snap install sarala" },
];

/** Shown on the page and emitted as FAQPage structured data (answers as plain text). */
const FAQ = [
  {
    q: "How is Sarala different from other Markdown editors?",
    a: [
      `Most editors show raw Markdown on one side and a preview on the other. Sarala renders each block in place as you type, so you read and edit the same page. Click a paragraph to see its Markdown, click away to see it rendered.`,
      `If you know Typora, the idea is similar, but Sarala is free, open source, and adds Mermaid and D2 diagrams, an AI assistant and offline voice typing.`,
    ],
  },
  {
    q: "Can I open my existing notes?",
    a: [`Yes. Open any folder of Markdown files, such as an Obsidian vault, a docs folder in a Git repository or notes from another editor. Sarala edits the files in place and adds nothing to them.`],
  },
  {
    q: "Does Sarala need the internet?",
    a: [`No. Sarala only goes online to check for updates, to load images your documents link to, and to download the speech model if you turn on voice typing. The AI assistant uses whichever agent you have installed, so it follows that agent's own connection and sign-in.`],
  },
  {
    q: "Is there a mobile or web version?",
    a: [`Not yet. Sarala is a desktop app for macOS, Windows and Linux. Because your documents are plain files, you can read and edit them on other devices with any Markdown app.`],
  },
];
const faqLd = {
  "@type": "FAQPage",
  mainEntity: FAQ.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.join(" ") },
  })),
};
---

<Layout extraLd={[faqLd]}>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="/" aria-label="Sarala home">
        <img src="/assets/icon-64.png" alt="" width="30" height="30" />
        Sarala
      </a>
      <nav class="nav-links" aria-label="Main">
        <a href="#features">Features</a>
        <a href="#ai">AI &amp; voice</a>
        <a href="#themes">Themes</a>
        <a href="#faq">FAQ</a>
      </nav>
      <div class="nav-end">
        <span class="swatches nav-swatches" role="group" aria-label="Theme">
          {THEMES.map((t) => (
            <button type="button" class="swatch" data-set-theme={t.id} style={`background:${t.dot}`} aria-label={`${t.name} theme`} aria-pressed="false"></button>
          ))}
        </span>
        <a class="nav-gh" href={GITHUB} target="_blank" rel="noopener" aria-label="Sarala on GitHub" set:html={svg("github")} />
        <a class="btn btn-primary nav-cta" href="#download">Download</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true">
        <div class="hero-grid"></div>
        <div class="hero-glyphs" id="hero-glyphs"></div>
      </div>
      <div class="wrap">
        <div class="hero-mark">
          <img src="/assets/icon-256.png" alt="" width="116" height="116" fetchpriority="high" />
        </div>
        <a class="eyebrow" href="#ai"><span class="pip" aria-hidden="true"></span><span class="eb-lead">free &amp; open source · v{VERSION} ·</span> <b>new: AI assistant &amp; voice typing</b></a>
        <h1 id="hero-title">Markdown that reads like a <span class="grad">finished&nbsp;document.</span></h1>
        <p class="hero-sub">
          Sarala is a free, open-source WYSIWYG Markdown editor for macOS, Windows and Linux. Write plain Markdown and
          see the finished document on the same page, with no preview pane and no split view.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" id="hero-dl" href="#download"><Fragment set:html={svg("download", "ico")} /><span>Download free</span></a>
          <a class="btn btn-ghost" href={GITHUB} target="_blank" rel="noopener"><Fragment set:html={svg("github", "ico")} />View on GitHub</a>
        </div>

        <!-- Real light-theme screenshots of the desktop app, fanned out on a
             studio backdrop, with hand-written notes pointing at what's new. -->
        <figure class="stage" aria-label="Screenshots of the Sarala desktop app">
          <div class="stage-panel">
            <img class="win win-left" src="/screenshots/crops/win-diagrams.webp" alt="A Kubernetes architecture note with a Mermaid flowchart rendered inline" width="1459" height="906" loading="eager" decoding="async" />
            <img class="win win-right" src="/screenshots/crops/win-ai-assistant.webp" alt="The AI assistant proposing edits to a runbook as diffs with Accept and Reject" width="1459" height="906" loading="eager" decoding="async" />
            <img class="win win-front" src="/screenshots/crops/hero-light.webp" alt="Sarala's live editor: a Markdown document with a callout, a table and a task list, rendered as you type" width="1459" height="906" fetchpriority="high" decoding="async" />
            <VoicePill class="f-voice" />

            <span class="note note-front">diagrams from plain text<Fragment set:html={`<svg viewBox="0 0 120 70" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 10c30 2 62 14 92 46"/><path d="M84 52l15 6-3-16"/></svg>`} /></span>
            <span class="note note-left">renders as you type<Fragment set:html={`<svg viewBox="0 0 120 70" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 10c30 2 62 14 92 46"/><path d="M84 52l15 6-3-16"/></svg>`} /></span>
            <span class="note note-right">AI edits you approve<Fragment set:html={`<svg viewBox="0 0 120 70" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 10c30 2 62 14 92 46"/><path d="M84 52l15 6-3-16"/></svg>`} /></span>
          </div>
          <figcaption class="platforms">
            <span>Runs natively on</span>
            <span class="os"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.7 2.8c.1 1-.3 2-1 2.8-.7.8-1.7 1.4-2.7 1.3-.1-1 .4-2 1-2.7.7-.8 1.8-1.3 2.7-1.4ZM19 17c-.5 1.2-.8 1.7-1.5 2.7-1 1.4-2.4 3.1-4.1 3.1-1.5 0-1.9-1-3.9-1-2 0-2.5 1-4 1-1.7 0-3-1.6-4-3C-.3 16.6-.6 11 1.7 8.3c1-1.3 2.6-2.1 4.1-2.1 1.6 0 2.6 1 3.9 1 1.3 0 2-1 3.9-1 1.4 0 2.9.8 3.9 2.1-3.4 1.9-2.9 6.8 1.6 8.7Z"/></svg>macOS</span>
            <span class="os"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 3.9 10.5 2.9v8.1H3V3.9ZM11.5 2.8 21 1.5V11H11.5V2.8ZM3 12.9h7.5V21L3 20V12.9ZM11.5 13H21v9.5L11.5 21.2V13Z"/></svg>Windows</span>
            <span class="os"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c-2.2 0-3.4 1.8-3.4 4.1 0 1.4.4 2.4-.4 3.6-.9 1.3-2.9 3.6-2.9 6.4 0 .9.2 1.7.6 2.4-.8.4-1.7.8-1.7 1.6 0 1 1.7 1.3 3.3 1.6 1.2.2 2 .6 3 .6 1.1 0 1.6-.7 2-.7s1 .7 2 .7c1 0 1.9-.4 3.1-.6 1.6-.3 3.2-.6 3.2-1.6 0-.8-.9-1.2-1.7-1.6.4-.7.6-1.5.6-2.4 0-2.8-2-5.1-2.9-6.4-.8-1.2-.4-2.2-.4-3.6C15.4 3.8 14.2 2 12 2Z"/></svg>Linux</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ============ SHOWCASE ============ -->
    <section class="section" id="features" aria-labelledby="showcase-title">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="kicker">Rich content</span>
          <h2 id="showcase-title">Diagrams, math, code and tables, right in the page</h2>
          <p>Type the Markdown you already know. Sarala renders it inline, so a technical document looks finished while you write it.</p>
        </div>

        <div class="reveal">
          <div class="tabs" role="tablist" aria-label="Rich content examples">
            {SHOWCASE.map((s, i) => (
              <button type="button" class="tab" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
                <Fragment set:html={svg(s.icon)} />{s.label}
              </button>
            ))}
          </div>
          {SHOWCASE.map((s, i) => (
            <div class="panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
              <figure class="shot">
                <button type="button" data-zoom aria-label={`Enlarge screenshot: ${s.title}`}>
                  <img src={`/screenshots/crops/win-${s.img}.webp`} alt={s.alt} width="1459" height="906" loading={i === 0 ? "eager" : "lazy"} decoding="async" />
                </button>
              </figure>
              <div class="panel-card">
                <span class="ti" set:html={svg(s.icon)} />
                <h3>{s.title}</h3>
                <p>{s.text}</p>
                <div class="md-card">
                  <div class="md-head"><span>You type</span><span class="md-file">notes.md</span></div>
                  <pre><code set:html={s.code} /></pre>
                  <div class="md-foot"><Fragment set:html={svg("arrow")} />Sarala renders it as shown</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ NEW IN 1.3: AI + VOICE ============ -->
    <section class="section alt" id="ai" aria-labelledby="ai-title">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="kicker">New in 1.3</span>
          <h2 id="ai-title">Help when you want it, and only then</h2>
          <p>An AI assistant that proposes instead of overwriting, and voice typing that never leaves your computer.</p>
        </div>
        <div class="duo">
          <article class="duo-card reveal">
            <figure class="shot">
              <button type="button" data-zoom aria-label="Enlarge screenshot: the AI assistant proposing edits">
                <img src="/screenshots/crops/win-ai-assistant.webp" alt="The AI assistant proposing two edits to a Kubernetes runbook in Sarala, shown as diffs with Accept and Reject buttons" width="1459" height="906" loading="lazy" decoding="async" />
              </button>
            </figure>
            <h3>AI assistant</h3>
            <p>Ask an agent to review, summarise or rewrite. Every change arrives as a diff you accept or reject.</p>
            <ul class="ticks">
              <li><Fragment set:html={svg("check")} />Nothing changes until you accept it</li>
              <li><Fragment set:html={svg("check")} />Uses the agent on your computer: no API keys</li>
              <li><Fragment set:html={svg("check")} />Works on a scratch copy, never your file</li>
            </ul>
            <div class="badge-row" aria-label="Supported agents"><span class="badge">Claude Code</span><span class="badge">OpenAI Codex</span><span class="badge">GitHub Copilot CLI</span></div>
          </article>
          <article class="duo-card reveal" id="voice">
            <figure class="shot">
              <button type="button" data-zoom aria-label="Enlarge screenshot: voice typing">
                <img src="/screenshots/crops/win-voice-typing.webp" alt="Voice typing in Sarala: a recording pill with a live waveform while words appear in the document" width="1459" height="906" loading="lazy" decoding="async" />
              </button>
              <VoicePill class="shot-pill" />
            </figure>
            <h3>Voice typing, fully offline</h3>
            <p>Hold a shortcut and talk. An open speech model on your computer turns it into text; nothing is uploaded.</p>
            <ul class="ticks">
              <li><Fragment set:html={svg("check")} />Push to talk, or tap to start and stop</li>
              <li><Fragment set:html={svg("check")} />Say “new paragraph” or “scratch that”</li>
              <li><Fragment set:html={svg("check")} />Set up in a minute, with a live mic check</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- ============ WRITING (feature tour) ============ -->
    <section class="section" id="writing" aria-labelledby="more-title">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="kicker">For long sessions</span>
          <h2 id="more-title">Settle in. Write for hours.</h2>
          <p>Everything that keeps you in flow, and nothing that pulls you out of it.</p>
        </div>

        <div class="flow reveal">
          <div class="flow-list" role="tablist" aria-orientation="vertical" aria-label="Writing features">
            <button type="button" class="flow-item" role="tab" id="flow-tab-focus" aria-controls="flow-focus" aria-selected="true" tabindex="0">
              <span class="ti" set:html={svg("eye")} />
              <span class="flow-progress" aria-hidden="true"><span></span></span><span class="flow-copy"><span class="flow-title">Focus and typewriter modes</span><span class="flow-desc">Fade everything but the paragraph you're writing, and keep your line in the middle of the screen.</span></span>
            </button>
            <button type="button" class="flow-item" role="tab" id="flow-tab-palette" aria-controls="flow-palette" aria-selected="false" tabindex="-1">
              <span class="ti" set:html={svg("command")} />
              <span class="flow-progress" aria-hidden="true"><span></span></span><span class="flow-copy"><span class="flow-title">One shortcut for everything</span><span class="flow-desc">Press ⌘K to run any command, switch theme, or jump to a file or heading.</span></span>
            </button>
            <button type="button" class="flow-item" role="tab" id="flow-tab-outline" aria-controls="flow-outline" aria-selected="false" tabindex="-1">
              <span class="ti" set:html={svg("tree")} />
              <span class="flow-progress" aria-hidden="true"><span></span></span><span class="flow-copy"><span class="flow-title">Outline, files and search</span><span class="flow-desc">Jump between headings in long documents, browse your folder, and search all of it.</span></span>
            </button>
            <button type="button" class="flow-item" role="tab" id="flow-tab-themes" aria-controls="themes" aria-selected="false" tabindex="-1">
              <span class="ti" set:html={svg("layers")} />
              <span class="flow-progress" aria-hidden="true"><span></span></span><span class="flow-copy"><span class="flow-title">Make it yours</span><span class="flow-desc">Thirteen light and dark themes, or your own, and any font on your computer.</span></span>
            </button>
          </div>

          <div class="flow-stage">
            <div class="flow-panel flow-photo" role="tabpanel" id="flow-focus" aria-labelledby="flow-tab-focus">
              <img class="flow-bg" src="/screenshots/crops/desk-night.webp" alt="" width="900" height="1069" loading="lazy" decoding="async" />
              <div class="focus-demo" aria-hidden="true">
                <span style="width:72%"></span><span style="width:90%"></span><span class="on" style="width:84%"></span><span style="width:66%"></span><span style="width:80%"></span>
              </div>
              <small class="credit">Photo: <a href="https://unsplash.com/photos/a-dimly-lit-desk-with-a-laptop-and-monitor-IUKdnYUlDco" target="_blank" rel="noopener">Zoshua Colah</a> on Unsplash</small>
            </div>
            <div class="flow-panel" role="tabpanel" id="flow-palette" aria-labelledby="flow-tab-palette" hidden>
              <img class="flow-shot" src="/screenshots/crops/palette.webp" alt="The command palette filtered to theme commands" width="608" height="444" loading="lazy" decoding="async" />
            </div>
            <div class="flow-panel" role="tabpanel" id="flow-outline" aria-labelledby="flow-tab-outline" hidden>
              <img class="flow-shot flow-shot-wide" src="/screenshots/crops/outline.webp" alt="The outline of a long Kafka guide next to the document, in the Night theme" width="808" height="870" loading="lazy" decoding="async" />
            </div>
            <div class="flow-panel" role="tabpanel" id="themes" aria-labelledby="flow-tab-themes" hidden>
              <div class="theme-gallery">
                {THEMES.map((t) => (
                  <button type="button" class="theme-card" data-set-theme={t.id} aria-pressed="false" style={`background:${t.bg};border-color:${t.border};color:${t.fg}`}>
                    <span class="tc-name">{t.name}</span>
                    <span class="tc-code" style="display:block"><span style={`color:${t.sw[0]}`}>#</span> Title<br /><span style={`color:${t.sw[1]}`}>**</span>bold<span style={`color:${t.sw[1]}`}>**</span></span>
                    <span class="tc-swatches">{t.sw.map((c) => <i style={`background:${c}`}></i>)}</span>
                  </button>
                ))}
              </div>
              <p class="flow-hint">Pick a theme to recolour this page.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ DOWNLOAD ============ -->
    <section class="section alt download-sec" id="download" aria-labelledby="dl-title">
      <div class="wrap">
        <div class="dl-head reveal">
          <span class="kicker">Download</span>
          <h2 id="dl-title">Get Sarala</h2>
          <p>Free and open source (GPL-3.0) for macOS, Windows and Linux.</p>
          <ul class="trust" aria-label="Why it's safe to try">
            <li><Fragment set:html={svg("shield")} />No telemetry, no account</li>
            <li><Fragment set:html={svg("heart")} />No paid tier, ever</li>
            <li><Fragment set:html={svg("hdd")} />Plain .md files you own</li>
          </ul>
        </div>
        <div class="pgrid reveal">
          {PLATFORMS.map((p) => (
            <article class="pcard" data-os={p.key} aria-labelledby={`pc-${p.key}`}>
              <span class="you-badge">Your system</span>
              <span class="picon" set:html={osSvg(p.key)} />
              <h3 id={`pc-${p.key}`}>{p.label}</h3>
              <p class="preq">{p.req}</p>
              <a class="btn btn-primary pdl" href={`${DL}/${p.build.file}`} download>
                <Fragment set:html={svg("download", "ico")} />{p.cta}
              </a>
              <p class="pmeta">{p.build.size} · version {VERSION}</p>
              <p class="palt">
                {p.alts.map((alt, i) => (
                  <Fragment>{i > 0 && <span aria-hidden="true"> · </span>}<a href={alt.href} {...(alt.href.startsWith("http") && !alt.href.includes("/download/") ? { target: "_blank", rel: "noopener" } : {})}>{alt.label}</a>{alt.note && <span class="pnote"> {alt.note}</span>}</Fragment>
                ))}
              </p>
            </article>
          ))}
        </div>

        <div class="circuit" aria-hidden="true" data-active="mac">
          <svg class="circuit-svg"></svg>
          <span class="chip"><span class="chip-label">install ▸ <b>macOS</b></span></span>
        </div>

        <div class="help reveal" id="install-help">
          <div class="help-head">
            <h3>Installing</h3>
            <div class="tabs help-tabs" role="tablist" aria-label="Install help by platform">
              {PLATFORMS.map((p, i) => (
                <button type="button" class="tab" role="tab" id={`help-tab-${p.key}`} aria-controls={`help-${p.key}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
                  <Fragment set:html={osSvg(p.key)} />{p.label}
                </button>
              ))}
            </div>
          </div>

          <div class="help-panel" role="tabpanel" id="help-mac" aria-labelledby="help-tab-mac">
            <div class="help-cols">
              <section aria-labelledby="gk-title" id="macos-first-launch">
                <h4 id="gk-title">With the .dmg</h4>
                <p>Sarala isn't notarized by Apple, so macOS blocks the first launch. One command clears it.</p>
                <ol class="way-steps">
                  <li><span>Drag <b>Sarala</b> into <b>Applications</b>.</span></li>
                  <li><span>Run this once in <b>Terminal</b>, then open Sarala.</span></li>
                </ol>
                <div class="cmd">
                  <div class="cmd-bar"><span>Terminal</span><button type="button" class="gk-copy copy-btn" data-copy="#gk-cmd"><span class="gk-copy-label">Copy</span></button></div>
                  <pre id="gk-cmd"><code>{QUARANTINE_CMD}</code></pre>
                </div>
                <details class="way-more">
                  <summary>No Terminal? Use System Settings instead</summary>
                  <ol class="way-steps">
                    <li><span>Open Sarala. When macOS blocks it, click <b>Done</b>.</span></li>
                    <li><span>In <b>System Settings › Privacy &amp; Security</b>, click <b>Open Anyway</b>.</span></li>
                  </ol>
                  <p class="fine">On macOS 14 or older, right-click Sarala and choose <b>Open</b>. A "Sarala is damaged" message is the same warning, and either route clears it.</p>
                </details>
              </section>
              <section aria-labelledby="brew-title" id="macos-homebrew">
                <h4 id="brew-title">With Homebrew <span class="way-tag">Recommended</span></h4>
                <p>No security prompt, and <code>brew upgrade</code> keeps Sarala up to date.</p>
                <div class="cmd">
                  <div class="cmd-bar"><span>Terminal</span><button type="button" class="gk-copy copy-btn" data-copy="#brew-cmd"><span class="gk-copy-label">Copy</span></button></div>
                  <pre id="brew-cmd">{BREW_CMDS.map((cmd) => <code class="ln">{cmd}</code>)}</pre>
                </div>
              </section>
            </div>
          </div>

          <div class="help-panel" role="tabpanel" id="help-win" aria-labelledby="help-tab-win" hidden>
            <div class="help-cols">
              <section>
                <h4>Running the installer</h4>
                <ol class="way-steps">
                  <li><span>Open <b>{BUILDS.win.file}</b> and follow the prompts. No administrator rights needed.</span></li>
                  <li><span>If Windows shows <b>"Windows protected your PC"</b>, click <b>More info</b>, then <b>Run anyway</b>.</span></li>
                </ol>
                <p class="fine">The installer isn't code-signed yet, so SmartScreen asks once. You can <a href={RELEASES} target="_blank" rel="noopener">verify the checksums</a> first.</p>
              </section>
              <section>
                <h4>For IT and managed devices</h4>
                <p>Use the <a href={`${DL}/${ALT.msi}`}>.msi package</a> ({ALT_SIZE.msi}) with your deployment tool. Updates install from inside the app either way.</p>
              </section>
            </div>
          </div>

          <div class="help-panel" role="tabpanel" id="help-linux" aria-labelledby="help-tab-linux" hidden>
            <div class="help-cols">
              {LINUX_CMDS.map((c) => (
                <section>
                  <h4>{c.label}</h4>
                  <div class="cmd">
                    <div class="cmd-bar"><span>Terminal</span><button type="button" class="gk-copy copy-btn" data-copy={`#${c.id}`}><span class="gk-copy-label">Copy</span></button></div>
                    <pre id={c.id}><code>{c.cmd}</code></pre>
                  </div>
                </section>
              ))}
            </div>
          </div>
          <p class="gk-copy-status visually-hidden" id="gk-copy-status" role="status" aria-live="polite"></p>
        </div>

        <p class="dl-foot"><a href={RELEASES} target="_blank" rel="noopener">All releases, release notes and checksums</a></p>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="section" id="faq" aria-labelledby="faq-title">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="kicker">FAQ</span>
          <h2 id="faq-title">Questions, answered</h2>
        </div>
        <div class="faq reveal">
          {FAQ.map((f) => (
            <details>
              <summary>{f.q}<Fragment set:html={svg("plus")} /></summary>
              <div class="answer">{f.a.map((p) => <p>{p}</p>)}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

