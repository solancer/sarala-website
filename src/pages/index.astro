---
import Layout from "../layouts/Layout.astro";
import VoicePill from "../components/VoicePill.astro";
import WebTry from "../components/WebTry.astro";
import Clip from "../components/Clip.astro";
import Plane from "../components/Plane.astro";
import { BRAND, type Brand } from "../brand-icons";
import { VERSION, GITHUB, RELEASES, SNAP, DL, BUILDS, ALT, ALT_SIZE, WEB_URL } from "../consts";

const LICENSE = `${GITHUB}/blob/main/LICENSE`;
const ISSUES = `${GITHUB}/issues`;
const CONTRIBUTING = `${GITHUB}/blob/main/CONTRIBUTING.md`;
const BREW_CMDS = [
  `brew tap solancer/sarala ${GITHUB}`,
  "brew trust --cask solancer/sarala/sarala",
  "brew install --cask --yes sarala",
];

/** Lucide-style icons on a 24px grid. */
const I = {
  download: '<path d="M12 3v12"/><path d="m7 11 5 5 5-5"/><path d="M5 21h14"/>',
  arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  arrowUp: '<path d="M12 19V5"/><path d="m6 11 6-6 6 6"/>',
  ext: '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  diagram: '<rect x="3" y="3" width="7" height="6" rx="1.5"/><rect x="14" y="15" width="7" height="6" rx="1.5"/><path d="M6.5 9v3.5a2 2 0 0 0 2 2H14"/>',
  sigma: '<path d="M18 7V4H6l6 8-6 8h12v-3"/>',
  code: '<path d="m8 6-6 6 6 6M16 6l6 6-6 6"/>',
  table: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  wifiOff: '<path d="M2 2l20 20"/><path d="M8.5 16.5a5 5 0 0 1 7 0"/><path d="M5 12.9a10 10 0 0 1 5.2-2.8M19 12.9a10 10 0 0 0-2.6-1.9"/><path d="M12 20h.01"/>',
  folder: '<path d="M3 6.5A1.5 1.5 0 0 1 4.5 5H9l2 2.5h8.5A1.5 1.5 0 0 1 21 9v9.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5z"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  play: '<path d="M7 4.5v15l13-7.5z"/>',
  pen: '<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="m14 6 4 4"/>',
  eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  file: '<path d="M6 2h9l5 5v15H6z"/><path d="M15 2v5h5"/>',
  github: '<path fill="currentColor" stroke="none" d="M12 1.5a10.5 10.5 0 0 0-3.32 20.46c.52.1.71-.23.71-.5v-1.77c-2.9.63-3.52-1.4-3.52-1.4-.47-1.2-1.16-1.52-1.16-1.52-.95-.65.07-.64.07-.64 1.05.08 1.6 1.08 1.6 1.08.93 1.6 2.45 1.14 3.05.87.1-.68.36-1.14.66-1.4-2.32-.27-4.76-1.16-4.76-5.16 0-1.14.4-2.07 1.07-2.8-.1-.27-.46-1.33.1-2.76 0 0 .88-.28 2.88 1.07a9.9 9.9 0 0 1 5.24 0c2-1.35 2.87-1.07 2.87-1.07.57 1.43.21 2.49.1 2.76.67.73 1.07 1.66 1.07 2.8 0 4.01-2.45 4.89-4.78 5.15.38.32.71.95.71 1.92v2.85c0 .28.19.61.72.5A10.5 10.5 0 0 0 12 1.5Z"/>',
};
const svg = (name: keyof typeof I) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${I[name]}</svg>`;
const brandSvg = (k: Brand) => `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="${BRAND[k]}"/></svg>`;
const OS_BRAND = { mac: "apple", win: "windows", linux: "linux" } as const;
const osSvg = (k: keyof typeof OS_BRAND) => brandSvg(OS_BRAND[k]);

/** Rich content: one numbered tab and one recording each. `code` is what you type. */
const RICH = [
  {
    id: "diagrams", n: "01", label: "Diagrams", icon: "diagram" as const, title: "Request path.md",
    text: "Mermaid and D2 diagrams render in the page and follow your theme.",
    code: '<span class="m">```mermaid</span>\nflowchart LR\n  user --> ingress',
    clip: "Typing a Mermaid flowchart in Sarala; it renders as a diagram when the caret leaves the block",
  },
  {
    id: "math", n: "02", label: "Math", icon: "sigma" as const, title: "Queueing math.md",
    text: "Inline and display LaTeX, typeset with KaTeX as you write.",
    code: '<span class="m">$$</span>\nW = \\frac{1}{\\mu - \\lambda}\n<span class="m">$$</span>',
    clip: "Typing a LaTeX equation in Sarala; it is typeset in place",
  },
  {
    id: "code", n: "03", label: "Code", icon: "code" as const, title: "Producer.md",
    text: "Fenced code, highlighted for more than 100 languages.",
    code: '<span class="m">```java</span>\nproducer.send(record);\n<span class="m">```</span>',
    clip: "Typing a Java code block in Sarala; it is syntax highlighted when the caret leaves it",
  },
  {
    id: "tables", n: "04", label: "Tables & tasks", icon: "table" as const, title: "Rollout.md",
    text: "Edit tables cell by cell. Tick tasks with a click.",
    code: '<span class="m">|</span> replicas <span class="m">|</span> 3 <span class="m">|</span>\n<span class="m">- [x]</span> Readiness probe',
    clip: "Editing a table cell and ticking a task in Sarala",
  },
];

/** Some of the app's themes, as swatches. */
const THEMES = [
  { name: "Sarala", bg: "#f3eee3", border: "#e4dccb", fg: "#2b2620", sw: ["#a7402d", "#8b5629", "#785e18", "#3e6d41", "#33697c", "#735496"] },
  { name: "Pro", bg: "#2d2a2e", border: "#403e41", fg: "#fcfcfa", sw: ["#ff6188", "#fc9867", "#ffd866", "#a9dc76", "#78dce8", "#ab9df2"] },
  { name: "Classic", bg: "#272822", border: "#3b3a32", fg: "#fdfff1", sw: ["#f92672", "#fd971f", "#e6db74", "#a6e22e", "#66d9ef", "#ae81ff"] },
  { name: "Octagon", bg: "#282a3a", border: "#3a3d4b", fg: "#eaf2f1", sw: ["#ff657a", "#ff9b5e", "#ffd76d", "#bad761", "#9cd1bb", "#c39ac9"] },
  { name: "Machine", bg: "#273136", border: "#3a464b", fg: "#f2fffc", sw: ["#ff6d7e", "#ffb270", "#ffed72", "#a2e57b", "#7cd5f1", "#baa0f8"] },
  { name: "Ristretto", bg: "#2c2525", border: "#403838", fg: "#fff1f3", sw: ["#fd6883", "#f38d70", "#f9cc6c", "#adda78", "#85dacc", "#a8a9eb"] },
  { name: "Spectrum", bg: "#222222", border: "#363636", fg: "#f7f1ff", sw: ["#fc618d", "#fd9353", "#fce566", "#7bd88f", "#5ad4e6", "#948ae3"] },
];

/** One column per platform; app.js marks the visitor's own. */
const PLATFORMS = [
  {
    key: "mac" as const, label: "macOS", req: "Apple silicon and Intel · macOS 10.15 or later",
    cta: "Download .dmg", href: `${DL}/${BUILDS.mac.file}`, download: true,
    meta: `${BUILDS.mac.size} · version ${VERSION} · signed and notarized`,
    alts: [{ label: "Install with Homebrew", href: "#help-mac", note: "" }],
  },
  {
    key: "win" as const, label: "Windows", req: "Windows 10 and 11 · 64-bit",
    cta: "Download installer", href: `${DL}/${BUILDS.win.file}`, download: true,
    meta: `${BUILDS.win.size} · version ${VERSION}`,
    alts: [{ label: ".msi package", href: `${DL}/${ALT.msi}`, note: ALT_SIZE.msi }],
  },
  {
    key: "linux" as const, label: "Linux", req: "64-bit · every major distribution",
    cta: "Get it from the Snap Store", href: SNAP, download: false,
    meta: "",
    code: "sudo snap install sarala",
    alts: [],
    distros: [
      { brand: "ubuntu" as const, name: "Ubuntu", fmt: ".deb", href: `${DL}/${ALT.deb}`, color: "#E95420" },
      { brand: "debian" as const, name: "Debian", fmt: ".deb", href: `${DL}/${ALT.deb}`, color: "#D70A53" },
      { brand: "fedora" as const, name: "Fedora", fmt: ".rpm", href: `${DL}/${ALT.rpm}`, color: "#51A2DA" },
      { brand: "opensuse" as const, name: "openSUSE", fmt: ".rpm", href: `${DL}/${ALT.rpm}`, color: "#73BA25" },
      { brand: null, name: "AppImage", fmt: "any", href: `${DL}/${BUILDS.linux.file}`, color: "" },
    ],
  },
];

/** Linux one-liners, per package format. */
const LINUX_CMDS = [
  { id: "lx-snap", label: "Snap Store (any distribution)", cmd: "sudo snap install sarala" },
  { id: "lx-deb", label: "Ubuntu, Debian, Mint (.deb)", cmd: `sudo apt install ./${ALT.deb}` },
  { id: "lx-rpm", label: "Fedora, RHEL, openSUSE (.rpm)", cmd: `sudo dnf install ./${ALT.rpm}` },
  { id: "lx-arch", label: "Arch, Manjaro, Omarchy (no build step)", cmd: `git clone --depth 1 ${GITHUB} && cd sarala/aur/sarala-bin && makepkg -si` },
  { id: "lx-appimage", label: "Any distribution (AppImage)", cmd: `chmod +x ${BUILDS.linux.file} && ./${BUILDS.linux.file}` },
];

/** Shown on the page and emitted as FAQPage structured data. */
const FAQ = [
  {
    q: "How is Sarala different from other Markdown editors?",
    a: [
      "Most editors show raw Markdown on one side and a preview on the other. Sarala renders each block in place as you type, so you read and edit the same page.",
      "If you know Typora, the idea is similar, but Sarala is free, open source, and adds Mermaid and D2 diagrams, an AI assistant and offline voice typing.",
    ],
  },
  {
    q: "Can I open my existing notes?",
    a: ["Yes. Open any folder of Markdown files, such as an Obsidian vault, a docs folder in a Git repository or notes from another editor. Sarala edits the files in place and adds nothing to them."],
  },
  {
    q: "Does Sarala need the internet?",
    a: ["No. Sarala only goes online to check for updates, to load images your documents link to, and to download the speech model if you turn on voice typing. The AI assistant follows your agent's own connection and sign-in."],
  },
  {
    q: "Is there a web version?",
    a: ["Yes, at web.sarala.solancer.com, with no account and nothing to install. It keeps documents in your browser, or in real folders in Chrome and Edge, and works offline after the first visit. The AI assistant is desktop only, because it runs the coding agents on your computer."],
  },
  {
    q: "Where does the web version keep my documents?",
    a: ["On your device. There is no server. Browser storage belongs to that browser, so clearing the site's data clears the library too. Back up from the Menu to get a zip of plain files, or work in a real folder."],
  },
  {
    q: "Can I export my documents?",
    a: ["Yes. Export to HTML and PDF, or to Word, LaTeX and EPUB through Pandoc. HTML export uses the same renderer as the editor, so the file looks like the page you wrote."],
  },
];
const SPLIT_SRC = '<span class="m">#</span> Trip notes\n<span class="m">- [x]</span> Book the train\n<span class="m">- [ ]</span> Print the hotel\nPack <span class="m">**</span>light<span class="m">**</span>.';
const PRICE = { q: "How much does Sarala cost?", a: ["Sarala is free and open source under the GPL-3.0. There is no paid tier."] };
const faqLd = {
  "@type": "FAQPage",
  mainEntity: [...FAQ, PRICE].map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.join(" ") },
  })),
};
---

<Layout extraLd={[faqLd]}>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="nav">
    <div class="nav-inner">
      <a class="brand" href="/" aria-label="Sarala home">
        <img src="/assets/icon-64.png" alt="" width="30" height="30" />
        <span>sarala<span class="dot">.</span></span>
      </a>
      <nav class="nav-links" aria-label="Main">
        <a href="#live">How it works</a>
        <a href="#voice">Voice &amp; AI</a>
        <a href="#web">Web app</a>
        <a href="#rich">Features</a>
        <a href={RELEASES} target="_blank" rel="noopener">Changelog</a>
      </nav>
      <div class="nav-end">
        <a class="nav-gh" href={GITHUB} target="_blank" rel="noopener" aria-label="Sarala on GitHub" set:html={svg("github")} />
        <a class="btn btn-dark btn-sm" href="#download"><span class="lbl-long">download sarala.</span><span class="lbl-short">download</span></a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="frame">
        <Plane variant="hero" />
        <div class="hero-copy">
          <h1 class="h1" id="hero-title">
            <span class="l1"><i class="hash" aria-hidden="true">#</i>markdown that reads like a <span class="md-b"><i class="mk" aria-hidden="true">**</i><mark>finished document</mark><i class="mk" aria-hidden="true">**</i></span>.</span>
            <span class="b">write plain text. see the page as you type.<i class="cur" aria-hidden="true"></i></span>
          </h1>
          <p class="lede">
            <strong>sarala</strong> is a free, open-source Markdown editor for macOS, Windows, Linux and the web.
            no preview pane, no split view. the page you write is the page you read.
          </p>
          <div class="hero-cta">
            <a class="btn btn-dark" href="#download"><span class="caret" aria-hidden="true"></span>download sarala.<span class="tag">Free</span></a>
            <a class="arrow-link" href={WEB_URL} target="_blank" rel="noopener">try it in your browser<Fragment set:html={svg("arrow")} /></a>
          </div>
          <p class="hero-meta">
            <span><Fragment set:html={osSvg("mac")} />macOS</span>
            <span><Fragment set:html={osSvg("win")} />Windows</span>
            <span><Fragment set:html={osSvg("linux")} />Linux</span>
            <span><Fragment set:html={svg("globe")} />Web</span>
            <span>v{VERSION} · GPL-3.0</span>
          </p>
          <div class="hero-cards" aria-hidden="true">
            <div class="mdc" style="--x:0px;--y:44px;--r:-5deg;--z:10;--d:-1s">
              <div class="mdc-in">
                <div class="f src"><small>source</small><span><b class="t">**</b>bold<b class="t">**</b> and <b class="t">_</b>italic<b class="t">_</b></span></div>
                <div class="f out"><small>page</small><span><strong>bold</strong> and <em>italic</em></span></div>
              </div>
            </div>
            <div class="mdc" style="--x:262px;--y:0px;--r:4deg;--z:18;--d:-3.2s">
              <div class="mdc-in">
                <div class="f src"><small>source</small><span><b class="t">- [x]</b> ship v1.6<br /><b class="t">- [ ]</b> write docs</span></div>
                <div class="f out"><small>page</small><span class="tasks"><i class="on"></i><s>ship v1.6</s><br /><i></i>write docs</span></div>
              </div>
            </div>
            <div class="mdc" style="--x:96px;--y:142px;--r:-2deg;--z:26;--d:-5.4s">
              <div class="mdc-in">
                <div class="f src"><small>source</small><span><b class="t">$</b>e^{'{'}i\pi{'}'} + 1 = 0<b class="t">$</b></span></div>
                <div class="f out"><small>page</small><span class="math">e<sup>iπ</sup> + 1 = 0</span></div>
              </div>
            </div>
            <div class="mdc" style="--x:356px;--y:124px;--r:6deg;--z:14;--d:-7.6s">
              <div class="mdc-in">
                <div class="f src"><small>source</small><span><b class="t">```mermaid</b><br />draft --&gt; ship</span></div>
                <div class="f out"><small>page</small><span class="flow"><em>draft</em><svg viewBox="0 0 28 10"><path d="M0 5h24m-5-4 5 4-5 4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg><em>ship</em></span></div>
              </div>
            </div>
          </div>
        </div>
        <div class="hero-stage">
          <Clip name="hero" title="Launch notes.md" ar="1280 / 520" eager
            label="Sarala recording: a document typed from nothing. The heading, bold text, a task list and a Mermaid diagram each render as they are written." />
        </div>
        <div class="strip">
          <p>one page. everything a technical document needs.</p>
          <nav aria-label="Rich content">
            {RICH.map((r) => <a href="#rich" data-open-tab={`tab-${r.id}`}><Fragment set:html={svg(r.icon)} />{r.label}</a>)}
          </nav>
        </div>
      </div>
    </section>

    <!-- ============ 01 LIVE EDITING ============ -->
    <section class="sec" id="live" aria-labelledby="live-title">
      <div class="frame">
        <div class="bar"><span class="num">01</span><span>Live editing</span><span class="cap">No preview pane.</span></div>
        <div class="big-head rv">
          <h2 class="h2" id="live-title"><span>your markdown stays markdown.</span><span class="b">now it looks finished.</span></h2>
        </div>
        <div class="cols c2 c2-live">
          <div class="cell rv">
            <h3 class="h3">most editors split the page in two.</h3>
            <p class="body" style="margin-top:14px">you write on one side and read on the other, and your eyes go back and forth all day.</p>
            <div class="split-demo" aria-hidden="true">
              <div class="mini">
                <div class="mini-bar"><i></i><i></i><i></i><span>source</span></div>
                <pre set:html={SPLIT_SRC} />
              </div>
              <div class="split-arrow"><svg viewBox="0 0 40 24"><path d="M4 8h32m-5-4 5 4-5 4M36 16H4m5-4-5 4 5 4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg><i class="eye"></i></div>
              <div class="mini">
                <div class="mini-bar"><i></i><i></i><i></i><span>preview</span></div>
                <div class="rendered"><b>Trip notes</b><span class="on">Book the train</span><span>Print the hotel</span>Pack <strong>light</strong>.</div>
              </div>
            </div>
          </div>
          <div class="media-cell wash rv">
            <h3 class="h3">sarala renders each block where you write it.</h3>
            <Clip name="source-live" title="Zero-downtime deploys.md" ar="1120 / 620"
              label="Sarala recording: a runbook switches to Source and back to Live, then the caret enters the table and the task list, where their Markdown appears." />
            <p class="say">
              <span>click a paragraph to see its markdown.</span>
              <span>click away and it renders in place.</span>
              <span>or switch the whole page to source.</span>
            </p>
          </div>
        </div>
        <div class="foot-row">
          <a class="arrow-link ruled" href={WEB_URL} target="_blank" rel="noopener">Try it now, no install<Fragment set:html={svg("arrow")} /></a>
        </div>
      </div>
    </section>

    <!-- ============ 02 VOICE ============ -->
    <section class="sec" id="voice" aria-labelledby="voice-title">
      <div class="frame">
        <div class="bar"><span class="num">02</span><span>Voice typing</span><span class="cap">Fully offline.</span></div>
        <div class="feature flip">
          <div class="media rv">
            <div class="voice-wrap">
              <figure class="win" style="--ar:1459 / 906">
                <img src="/screenshots/crops/win-voice-typing.webp" alt="Voice typing in Sarala: a recording pill with a live waveform while words appear in the document" width="1459" height="906" loading="lazy" decoding="async" />
              </figure>
              <VoicePill />
            </div>
          </div>
          <div class="copy rv">
            <h2 class="h2" id="voice-title"><span>hold a key and talk.</span><span class="b">nothing is uploaded.</span></h2>
            <p class="lede">an open speech model on your computer turns your voice into text. it was built for people who find typing hard, and it's handy for everyone else.</p>
            <ul class="ticks">
              <li>push to talk, or tap to start and stop.</li>
              <li>say “new paragraph” or “scratch that”.</li>
              <li>set up in a minute, with a live mic check.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 03 WEB ============ -->
    <section class="sec" id="web" aria-labelledby="web-title">
      <div class="frame">
        <div class="bar"><span class="num">03</span><span>In your browser</span><span class="cap">Nothing to install.</span></div>
        <div class="web-grid">
          <div class="wash rv"><WebTry /></div>
          <div class="web-copy rv">
            <h2 class="h2" id="web-title"><span>nothing to install.</span><span class="b">start typing.</span></h2>
            <p class="lede"><strong>sarala</strong> runs in your browser too. it's the same editor, and your writing still never leaves your device.</p>
            <div class="chips">
              <span class="chip on"><Fragment set:html={svg("user")} />No account</span>
              <span class="chip"><Fragment set:html={svg("wifiOff")} />Works offline</span>
              <span class="chip"><Fragment set:html={svg("folder")} />Real folders</span>
              <span class="chip"><Fragment set:html={svg("download")} />Installs as an app</span>
            </div>
            <ul class="facts">
              <li><b>Yours alone.</b> Documents stay in this browser, or in real folders in Chrome and Edge.</li>
              <li><b>Handles big files.</b> Tens of thousands of lines open quickly and scroll smoothly.</li>
            </ul>
            <a class="btn btn-dark" href={WEB_URL} target="_blank" rel="noopener">open sarala in your browser<Fragment set:html={svg("ext")} /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 04 PRIVATE ============ -->
    <section class="sec" id="private" aria-labelledby="private-title">
      <div class="frame">
        <div class="bar"><span class="num">04</span><span>Private by default</span><span class="cap">On your computer.</span></div>
        <div class="big-head rv">
          <Plane variant="band" />
          <h2 class="h2" id="private-title" style="position:relative"><span>your notes stay yours.</span><span class="b">plain files, on your machine.</span></h2>
        </div>
        <div class="nos">
          <div class="no rv"><b aria-hidden="true">No</b><p><span class="visually-hidden">No </span>account.</p></div>
          <div class="no rv"><b aria-hidden="true">No</b><p><span class="visually-hidden">No </span>telemetry.</p></div>
          <div class="no rv"><b aria-hidden="true">No</b><p><span class="visually-hidden">No </span>lock-in. just <strong>.md</strong> files you own.</p></div>
        </div>
        <div class="tagline-row">
          <p>just your files, your editor and your machine.</p>
          <span class="rule" aria-hidden="true"><i></i></span>
          <p class="b">free, with no paid tier.</p>
        </div>
      </div>
    </section>

    <!-- ============ 05 RICH CONTENT ============ -->
    <section class="sec" id="rich" aria-labelledby="rich-title">
      <div class="frame">
        <div class="bar"><span class="num">05</span><span>Rich content</span><span class="cap">Type it. See it.</span></div>
        <div class="big-head rv">
          <h2 class="h2" id="rich-title"><span>diagrams, math, code and tables.</span><span class="b">right in the page.</span></h2>
          <p class="lede">type the markdown you already know. sarala renders it inline, so a technical document looks finished while you write it.</p>
        </div>
        <div class="cols c4" role="tablist" aria-label="Rich content examples" data-tabs="rich">
          {RICH.map((r, i) => (
            <button type="button" class="step" role="tab" id={`tab-${r.id}`} aria-controls={`rich-${r.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
              <span class="k"><span class="n">{r.n}</span><i></i>{r.label}</span>
              <p>{r.text}</p>
              <code set:html={r.code} />
              <span class="prog" aria-hidden="true"><i></i></span>
            </button>
          ))}
        </div>
        <div class="stage">
          {RICH.map((r, i) => (
            <div role="tabpanel" id={`rich-${r.id}`} aria-labelledby={`tab-${r.id}`} hidden={i !== 0}>
              <div class="label" aria-hidden="true"><Fragment set:html={svg("play")} />{r.n} / {r.label}<span class="w">recorded in Sarala for the web</span></div>
              <Clip name={r.id} title={r.title} ar="1120 / 560" loop={false} label={r.clip} />
            </div>
          ))}
        </div>
        <div class="foot-row">
          <p>footnotes, callouts, emoji and front matter too.</p>
          <a class="arrow-link" href={`${GITHUB}#readme`} target="_blank" rel="noopener">everything it renders<Fragment set:html={svg("arrow")} /></a>
        </div>
      </div>
    </section>

    <!-- ============ 06 AI ASSISTANT ============ -->
    <section class="sec" id="ai" aria-labelledby="ai-title">
      <div class="frame">
        <div class="bar"><span class="num">06</span><span>AI assistant</span><span class="cap">Desktop app.</span></div>
        <div class="feature">
          <div class="copy rv">
            <h2 class="h2" id="ai-title"><span>an assistant that proposes.</span><span class="b">you decide.</span></h2>
            <p class="lede">ask an agent to review, summarise or rewrite. every change arrives as a diff you accept or reject.</p>
            <div class="agents" aria-label="Supported agents">
              <span class="agent"><b>Claude Code</b><span>Ready</span></span>
              <span class="agent"><b>OpenAI Codex</b><span>Ready</span></span>
              <span class="agent"><b>Copilot CLI</b><span>Ready</span></span>
            </div>
            <ul class="ticks">
              <li>nothing changes until you accept it.</li>
              <li>uses the agent already on your computer. no api keys.</li>
              <li>works on a scratch copy, never your file.</li>
            </ul>
          </div>
          <div class="media rv">
            <figure class="win" style="--ar:1459 / 906">
              <img src="/screenshots/crops/win-ai-assistant.webp" alt="The AI assistant proposing two edits to a Kubernetes runbook, shown as diffs with Accept and Reject buttons" width="1459" height="906" loading="lazy" decoding="async" />
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 07 THEMES ============ -->
    <section class="sec" id="themes" aria-labelledby="themes-title">
      <div class="frame">
        <div class="bar"><span class="num">07</span><span>Make it yours</span><span class="cap">Light and dark.</span></div>
        <div class="big-head rv">
          <h2 class="h2" id="themes-title">thirteen themes. <span class="b" style="display:inline">or your own.</span></h2>
          <p class="lede">pick a palette from the status bar and the whole editor follows, diagrams and code included. use any font on your computer.</p>
        </div>
        <div class="themes-stage">
          <Clip name="themes" title="Zero-downtime deploys.md" ar="1120 / 640"
            label="Sarala recording: choosing themes from the status bar palette recolours the editor, from warm parchment through several dark themes and back." />
        </div>
        <div class="theme-row" aria-label="Some of Sarala's themes">
          {THEMES.map((t, i) => (
            <div class="theme">
              <p class="lab">{String(i + 1).padStart(2, "0")} / <b>{t.name}</b></p>
              <div class="card" style={`background:${t.bg};border-color:${t.border};color:${t.fg}`} aria-hidden="true">
                <span style={`color:${t.sw[0]}`}>#</span> Title<br /><span style={`color:${t.sw[1]}`}>**</span>bold<span style={`color:${t.sw[1]}`}>**</span>
              </div>
              <div class="sw" aria-hidden="true">{t.sw.map((c) => <i style={`background:${c}`}></i>)}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 08 LONG SESSIONS ============ -->
    <section class="sec" id="writing" aria-labelledby="writing-title">
      <div class="frame">
        <div class="bar"><span class="num">08</span><span>For long sessions</span><span class="cap">Settle in.</span></div>
        <div class="big-head rv">
          <h2 class="h2" id="writing-title"><span>everything that keeps you writing.</span><span class="b">nothing that pulls you out.</span></h2>
        </div>
        <div class="cols c4">
          <div class="tool rv">
            <span class="k"><span class="n">01</span><i></i>Focus</span>
            <p>Fade everything but the paragraph you're writing, and keep your line in the middle.</p>
            <div class="pic" aria-hidden="true"><div class="focus-lines"><span style="width:72%"></span><span style="width:90%"></span><span class="on" style="width:84%"></span><span style="width:66%"></span><span style="width:80%"></span></div></div>
          </div>
          <div class="tool rv">
            <span class="k"><span class="n">02</span><i></i>One shortcut</span>
            <p>Press ⌘K to run any command, switch theme, or jump to a file or heading.</p>
            <div class="pic" aria-hidden="true"><div class="kbd-demo"><kbd>⌘</kbd><kbd>K</kbd></div></div>
          </div>
          <div class="tool rv">
            <span class="k"><span class="n">03</span><i></i>Outline</span>
            <p>Jump between headings in long documents, browse your folder and search all of it.</p>
            <div class="pic"><img src="/screenshots/crops/outline.webp" alt="The outline of a long Kafka guide beside the document" width="808" height="870" loading="lazy" decoding="async" /></div>
          </div>
          <div class="tool rv">
            <span class="k"><span class="n">04</span><i></i>Export</span>
            <p>Send it anywhere. HTML export uses the same renderer as the editor.</p>
            <div class="pic" aria-hidden="true"><div class="exports"><span>.html</span><span>.pdf</span><span>.docx</span><span>.tex</span><span>.epub</span><span>.md</span></div></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 09 FAQ ============ -->
    <section class="sec" id="faq" aria-labelledby="faq-title">
      <div class="frame">
        <div class="bar"><span class="num">09</span><span>Questions</span><span class="cap">Answered.</span></div>
        <div class="faq">
          <div class="faq-title"><Plane variant="corner" /><h2 id="faq-title">FAQ</h2></div>
          {FAQ.map((f, i) => (
            <div class="qa">
              <span class="n">{String(i + 1).padStart(2, "0")}</span>
              <h3>{f.q}</h3>
              {f.a.map((p) => <p>{p}</p>)}
            </div>
          ))}
          <div class="qa">
            <span class="n">07</span>
            <h3>{PRICE.q}</h3>
            <p class="big">sarala is <span class="b">free.</span></p>
            <p>Open source under the GPL-3.0. There is no paid tier.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 10 DOWNLOAD ============ -->
    <section class="sec" id="download" aria-labelledby="dl-title">
      <div class="frame">
        <div class="bar"><span class="num">10</span><span>Download sarala</span><span class="cap">v{VERSION}</span></div>
        <div class="closing">
          <Plane variant="closing" />
          <div class="sel">
            <span class="hd" aria-hidden="true"></span><span class="hd" aria-hidden="true"></span><span class="hd" aria-hidden="true"></span><span class="hd" aria-hidden="true"></span>
            <h2 id="dl-title"><span>the page you write</span><span class="b">is the page you read.<span class="cur" aria-hidden="true"></span></span></h2>
            <span class="dim" aria-hidden="true">sarala (<span lang="kn">ಸರಳ</span>) · simple</span>
          </div>
          <p class="lede"><strong>sarala</strong> is a Markdown editor that gets out of the way, so writing feels like reading.</p>
          <p class="trio" aria-hidden="true">
            <span><Fragment set:html={svg("pen")} />you type markdown.</span>
            <span><Fragment set:html={svg("eye")} />it renders in place.</span>
            <span><Fragment set:html={svg("file")} />you keep plain files.</span>
          </p>
        </div>

        <div class="platforms">
          {PLATFORMS.map((p) => (
            <article class="pf" data-os={p.key} aria-labelledby={`pf-${p.key}`}>
              <span class="you">Your system</span>
              <div class="os"><Fragment set:html={osSvg(p.key)} /><h3 id={`pf-${p.key}`}>{p.label}</h3></div>
              <p class="req">{p.req}</p>
              {p.download ? (
                <a class="btn btn-dark" href={p.href} download><Fragment set:html={svg("download")} />{p.cta}</a>
              ) : (
                <a class="btn btn-dark" href={p.href} target="_blank" rel="noopener"><Fragment set:html={brandSvg("snap")} />{p.cta}</a>
              )}
              <p class="meta">{"code" in p ? <>or run <code>{p.code}</code></> : p.meta}</p>
              {"distros" in p && (
                <ul class="distros" aria-label="Or download a package for your distribution">
                  {p.distros.map((d) => (
                    <li><a href={d.href} download style={d.color ? `--brand:${d.color}` : ""}>
                      {d.brand ? <Fragment set:html={brandSvg(d.brand)} /> : <Fragment set:html={svg("file")} />}
                      <span>{d.name}</span><span class="f">{d.fmt}</span>
                    </a></li>
                  ))}
                </ul>
              )}
              {p.alts.length > 0 && (
                <p class="alt">{p.alts.map((alt) => <><a href={alt.href}>{alt.label}</a>{alt.note && <span> · {alt.note}</span>}</>)}</p>
              )}
            </article>
          ))}
        </div>

        <div class="help" id="install-help">
          <div class="help-head">
            <h3>Installing</h3>
            <div class="seg" role="tablist" aria-label="Install help by platform" data-tabs="help">
              {PLATFORMS.map((p, i) => (
                <button type="button" role="tab" id={`help-tab-${p.key}`} aria-controls={`help-${p.key}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
                  <Fragment set:html={osSvg(p.key)} />{p.label}
                </button>
              ))}
            </div>
          </div>

          <div class="help-panel" role="tabpanel" id="help-mac" aria-labelledby="help-tab-mac">
            <section id="macos-first-launch" aria-labelledby="gk-title">
              <h4 id="gk-title">With the .dmg</h4>
              <p>Sarala is signed and notarized by Apple, so it opens like any other app.</p>
              <ol>
                <li><span>Open <b>{BUILDS.mac.file}</b>.</span></li>
                <li><span>Drag <b>Sarala</b> into <b>Applications</b>, then open it.</span></li>
              </ol>
              <p>Sarala updates itself: when a new version is out, it asks before installing.</p>
            </section>
            <section id="macos-homebrew" aria-labelledby="brew-title">
              <h4 id="brew-title">With Homebrew</h4>
              <div class="cmd">
                <div class="cmd-bar"><span>Terminal</span><button type="button" class="copy-btn" data-copy="#brew-cmd">Copy</button></div>
                <pre id="brew-cmd">{BREW_CMDS.map((cmd) => <code>{cmd}</code>)}</pre>
              </div>
            </section>
          </div>

          <div class="help-panel" role="tabpanel" id="help-win" aria-labelledby="help-tab-win" hidden>
            <section>
              <h4>Running the installer</h4>
              <ol>
                <li><span>Open <b>{BUILDS.win.file}</b> and follow the prompts. No administrator rights needed.</span></li>
                <li><span>If Windows shows <b>"Windows protected your PC"</b>, click <b>More info</b>, then <b>Run anyway</b>.</span></li>
              </ol>
              <p>The installer isn't code-signed yet, so SmartScreen asks once. You can <a href={RELEASES} target="_blank" rel="noopener">verify the checksums</a> first.</p>
            </section>
            <section>
              <h4>For IT and managed devices</h4>
              <p>Use the <a href={`${DL}/${ALT.msi}`}>.msi package</a> ({ALT_SIZE.msi}) with your deployment tool. Updates install from inside the app either way.</p>
            </section>
          </div>

          <div class="help-panel" role="tabpanel" id="help-linux" aria-labelledby="help-tab-linux" hidden>
            {LINUX_CMDS.map((c) => (
              <section>
                <h4>{c.label}</h4>
                <div class="cmd">
                  <div class="cmd-bar"><span>Terminal</span><button type="button" class="copy-btn" data-copy={`#${c.id}`}>Copy</button></div>
                  <pre id={c.id}><code>{c.cmd}</code></pre>
                </div>
              </section>
            ))}
          </div>
          <p class="visually-hidden" id="copy-status" role="status" aria-live="polite"></p>
        </div>

        <p class="dl-foot">
          <span>Free and open source (GPL-3.0). Or <a href={WEB_URL} target="_blank" rel="noopener">open it in your browser</a>.</span>
          <a href={RELEASES} target="_blank" rel="noopener">All releases, notes and checksums</a>
        </p>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="frame">
      <div class="f-cols">
        <div class="f-brand">
          <a class="brand" href="/"><img src="/assets/icon-64.png" alt="" width="30" height="30" /><span>sarala<span class="dot">.</span></span></a>
          <p>A free, open-source Markdown editor that renders as you type. Sarala (<span lang="kn">ಸರಳ</span>) means “simple”.</p>
        </div>
        <nav class="f-col" aria-labelledby="f-product">
          <h2 id="f-product">Product</h2>
          <ul>
            <li><a href="#download">Download</a></li>
            <li><a href={WEB_URL} target="_blank" rel="noopener">Web app</a></li>
            <li><a href="#ai">AI assistant</a></li>
            <li><a href="#voice">Voice typing</a></li>
          </ul>
        </nav>
        <nav class="f-col" aria-labelledby="f-learn">
          <h2 id="f-learn">Learn</h2>
          <ul>
            <li><a href={`${GITHUB}#readme`} target="_blank" rel="noopener">Documentation</a></li>
            <li><a href={RELEASES} target="_blank" rel="noopener">Changelog</a></li>
            <li><a href="#faq">FAQ</a></li>
          </ul>
        </nav>
        <nav class="f-col" aria-labelledby="f-oss">
          <h2 id="f-oss">Open source</h2>
          <ul>
            <li><a href={GITHUB} target="_blank" rel="noopener"><Fragment set:html={svg("github")} />GitHub</a></li>
            <li><a href={LICENSE} target="_blank" rel="noopener">GPL-3.0 license</a></li>
            <li><a href={CONTRIBUTING} target="_blank" rel="noopener">Contributing</a></li>
            <li><a href={ISSUES} target="_blank" rel="noopener">Report an issue</a></li>
          </ul>
        </nav>
        <nav class="f-col" aria-labelledby="f-more">
          <h2 id="f-more">More</h2>
          <ul>
            <li><a href={SNAP} target="_blank" rel="noopener">Snap Store</a></li>
            <li><a href="https://solancer.com" target="_blank" rel="noopener">Author</a></li>
            <li><a href="#main">Back to top<Fragment set:html={svg("arrowUp")} /></a></li>
          </ul>
        </nav>
      </div>
      <div class="wordmark" aria-hidden="true">
        <span class="w"><img class="logo" src="/assets/icon-512.png" alt="" width="512" height="512" loading="lazy" /><span class="kn" lang="kn">ಸರಳ</span><i>.</i></span>
        <span class="stamp">
          <svg viewBox="0 0 120 120">
            <defs><path id="stamp-ring" d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0" /></defs>
            <circle cx="60" cy="60" r="57" fill="none" stroke="currentColor" stroke-width="1.5" />
            
            <g class="ring"><text font-family="JetBrains Mono, monospace" font-size="9.6" font-weight="600" fill="currentColor"><textPath href="#stamp-ring" textLength="272" lengthAdjust="spacing">FREE · OPEN SOURCE · GPL-3.0 ·</textPath></text></g>
            
          </svg>
        </span>
      </div>
      <div class="f-base">
        <span>© 2026 Sarala · GPL-3.0</span>
        <span class="ok"><i aria-hidden="true"></i>Build {VERSION} · signed updates · no telemetry</span>
      </div>
    </div>
  </footer>
</Layout>
