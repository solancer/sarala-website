              <span class="tc-swatches">{t.sw.map((c) => <i style={`background:${c}`}></i>)}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ OPEN SOURCE ============ -->
    <section class="section alt" id="opensource" aria-labelledby="oss-title">
      <div class="wrap oss">
        <div class="sec-head reveal">
          <span class="kicker">Open source</span>
          <h2 id="oss-title">Free forever, and yours to change</h2>
          <p>Sarala is released under the GNU GPL-3.0. Read every line, build it yourself, or fork it. Issues and pull requests are welcome.</p>
          <div class="oss-actions">
            <a class="btn btn-primary" href={GITHUB} target="_blank" rel="noopener"><Fragment set:html={svg("github", "ico")} />Star on GitHub</a>
            <a class="btn btn-ghost" href={CONTRIBUTING} target="_blank" rel="noopener">Contributing guide</a>
          </div>
        </div>
        <ul class="oss-list reveal" data-stagger>
          <li><span class="pi" set:html={svg("shield")} /><div><h3>No telemetry</h3><p>Sarala never reports what you write or how you use it. You can check the code.</p></div></li>
          <li><span class="pi" set:html={svg("heart")} /><div><h3>No paid tier</h3><p>Every feature is in the free download. No licence keys, no subscription.</p></div></li>
          <li><span class="pi" set:html={svg("code")} /><div><h3>Built with Tauri, Rust and SolidJS</h3><p>A native app that starts fast and stays light on memory.</p></div></li>
        </ul>
      </div>
    </section>

