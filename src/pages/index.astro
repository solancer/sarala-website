---
import Layout from "../layouts/Layout.astro";
import { VERSION, GITHUB, RELEASES, SNAP, DL, BUILDS, ALT, MAC_APP_PATH } from "../consts";

const LICENSE = `${GITHUB}/blob/main/LICENSE`;
const ISSUES = `${GITHUB}/issues`;
const CONTRIBUTING = `${GITHUB}/blob/main/CONTRIBUTING.md`;
const QUARANTINE_CMD = `xattr -dr com.apple.quarantine ${MAC_APP_PATH}`;
const BREW_CMDS = [
  `brew tap solancer/sarala ${GITHUB}`,
  "brew trust --cask solancer/sarala/sarala",
  "brew install --cask --yes sarala",
];

/** Lucide-style icons (24px grid, stroke) used across the page. */
const I = {
  download: '<path d="M12 3v12"/><path d="m7 11 5 5 5-5"/><path d="M5 21h14"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  file: '<path d="M6 2h9l5 5v15H6z"/><path d="M15 2v5h5"/>',
  folder: '<path d="M3 6.5A1.5 1.5 0 0 1 4.5 5H9l2 2.5h8.5A1.5 1.5 0 0 1 21 9v9.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5z"/>',
  chevR: '<path d="m9 6 6 6-6 6"/>',
  chevD: '<path d="m6 9 6 6 6-6"/>',
  files: '<path d="M15 2H8a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z"/><path d="M15 2v5h5"/><path d="M4 7v13a2 2 0 0 0 2 2h10"/>',
  outline: '<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  trash: '<path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/>',
  refresh: '<path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 4v7h-7"/>',
  collapse: '<path d="m7 20 5-5 5 5M7 4l5 5 5-5"/>',
  newfile: '<path d="M14 2H6v20h12V6z"/><path d="M12 11v6M9 14h6"/>',
  openfolder: '<path d="M3 7.5V18a2 2 0 0 0 2 2h14l2-8H7l-2 8"/><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6H9l2 2h6.5A1.5 1.5 0 0 1 19 9.5V12"/>',
  sidebar: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  mic: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>',
  focus: '<path d="M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16"/><circle cx="12" cy="12" r="2.5"/>',
  sparkle: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
  layers: '<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>',
  hdd: '<path d="M4 6h16v12H4z"/><path d="M8 14h.01M12 14h4"/>',
  shield: '<path d="M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6z"/><path d="m9 12 2 2 4-4"/>',
  diagram: '<rect x="3" y="3" width="7" height="6" rx="1.5"/><rect x="14" y="15" width="7" height="6" rx="1.5"/><path d="M6.5 9v3.5a2 2 0 0 0 2 2H14"/>',
  sigma: '<path d="M18 7V4H6l6 8-6 8h12v-3"/>',
  code: '<path d="m8 6-6 6 6 6M16 6l6 6-6 6"/>',
  table: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16"/>',
  command: '<path d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3"/>',
  tree: '<path d="M4 4h6v5H4zM14 15h6v5h-6zM14 4h6v5h-6z"/><path d="M7 9v8.5h7M10 6.5h4"/>',
  tabs: '<path d="M3 8h18v12H3z"/><path d="M3 8V5a1 1 0 0 1 1-1h6l2 4"/>',
  eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  exportIcon: '<path d="M12 15V3"/><path d="m7 8 5-5 5 5"/><path d="M5 14v6h14v-6"/>',
  image: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 17-5-5-9 8"/>',
  md: '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M6 15V9l3 3 3-3v6M17 9v6m-2-2 2 2 2-2"/>',
  update: '<path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/>',
  keyboard: '<rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10"/>',
  github: '<path fill="currentColor" stroke="none" d="M12 1.5a10.5 10.5 0 0 0-3.32 20.46c.52.1.71-.23.71-.5v-1.77c-2.9.63-3.52-1.4-3.52-1.4-.47-1.2-1.16-1.52-1.16-1.52-.95-.65.07-.64.07-.64 1.05.08 1.6 1.08 1.6 1.08.93 1.6 2.45 1.14 3.05.87.1-.68.36-1.14.66-1.4-2.32-.27-4.76-1.16-4.76-5.16 0-1.14.4-2.07 1.07-2.8-.1-.27-.46-1.33.1-2.76 0 0 .88-.28 2.88 1.07a9.9 9.9 0 0 1 5.24 0c2-1.35 2.87-1.07 2.87-1.07.57 1.43.21 2.49.1 2.76.67.73 1.07 1.66 1.07 2.8 0 4.01-2.45 4.89-4.78 5.15.38.32.71.95.71 1.92v2.85c0 .28.19.61.72.5A10.5 10.5 0 0 0 12 1.5Z"/>',
  heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"/>',
};
const svg = (name: keyof typeof I, cls = "", style = "") =>
  `<svg${cls ? ` class="${cls}"` : ""}${style ? ` style="${style}"` : ""} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${I[name]}</svg>`;

/** Rich content, one tab each. `code` is what you'd type to get the screenshot. */
const SHOWCASE = [
  {
    id: "diagrams", label: "Diagrams", icon: "diagram" as const, img: "diagrams",
    alt: "A Mermaid flowchart of a Kubernetes request path, rendered inline in a Sarala document",
    title: "Mermaid and D2 diagrams",
    text: "Flowcharts, sequence diagrams and architecture maps render right in the page and follow your theme. Click a diagram to edit its source.",
    code: "```mermaid\nflowchart LR\n  user --> ingress --> service\n```",
  },
  {
    id: "math", label: "Math", icon: "sigma" as const, img: "math",
    alt: "Queueing-theory equations typeset with KaTeX in Sarala",
    title: "LaTeX math, typeset as you write",
    text: "Inline and display equations render with KaTeX, with optional equation numbering and references.",
    code: "$$\nW = \\frac{1}{\\mu - \\lambda}\n$$",
  },
  {
    id: "code", label: "Code", icon: "code" as const, img: "code",
    alt: "A syntax-highlighted Java Kafka producer in Sarala's Night theme, with the document outline beside it",
    title: "Code blocks with real highlighting",
    text: "Fenced code is highlighted for more than 100 languages, using colours from your theme.",
    code: "```java\nproducer.send(record);\n```",
  },
  {
    id: "tables", label: "Tables & tasks", icon: "table" as const, img: "tables",
    alt: "A settings table, a rollout checklist and a warning callout in Sarala's GitHub theme",
    title: "Tables, task lists and callouts",
    text: "Edit tables cell by cell, tick tasks with a click, and use GitHub-style callouts for notes and warnings.",
    code: "| Setting | Value |\n| :-- | --: |\n- [x] Readiness probe\n> [!WARNING]",
  },
  {
    id: "palette", label: "Command palette", icon: "command" as const, img: "command-palette",
    alt: "Sarala's command palette listing themes with colour swatches",
    title: "Every action, one shortcut away",
    text: "Press ⌘K (Ctrl+K on Windows and Linux) to run any command, switch theme, or jump to a file or heading.",
    code: "⌘K  → theme night",
  },
];

const FEATURES = [
  { icon: "tree" as const, title: "Folders, outline and search", text: "Open a folder to browse it as a file tree, jump between headings, and search every document at once." },
  { icon: "tabs" as const, title: "Tabs", text: "Keep several documents open and switch between them without losing your place." },
  { icon: "eye" as const, title: "Focus and typewriter modes", text: "Dim everything but the paragraph you're writing, and keep the current line centred." },
  { icon: "image" as const, title: "Images that just work", text: "Paste or drop an image and Sarala saves it next to your document, with a relative link." },
  { icon: "md" as const, title: "GitHub-flavoured Markdown", text: "Tables, task lists, footnotes, callouts, emoji shortcodes and YAML front matter." },
  { icon: "exportIcon" as const, title: "Export", text: "Save as HTML or PDF, or as Word, LaTeX and EPUB through Pandoc." },
  { icon: "keyboard" as const, title: "Keyboard first", text: "Shortcuts for every format, a slash menu for blocks, and full keyboard navigation." },
  { icon: "layers" as const, title: "Your fonts", text: "Pick any font installed on your computer for writing and for code." },
  { icon: "update" as const, title: "Automatic updates", text: "New versions install from inside the app, or through Homebrew, Snap and your package manager." },
];

const THEMES = [
  { id: "paper", dot: "#f3eee3", name: "Sarala", sub: "Warm parchment, light", bg: "#f3eee3", border: "#e4dccb", fg: "#2b2620", accent: "#9a4b28", on: "#fff8f2", sw: ["#a7402d", "#8b5629", "#785e18", "#3e6d41", "#33697c", "#735496"] },
  { id: "pro", dot: "#ff6188", name: "Pro", sub: "Warm dark", bg: "#2d2a2e", border: "#403e41", fg: "#fcfcfa", accent: "#ff6188", on: "#2d2a2e", sw: ["#ff6188", "#fc9867", "#ffd866", "#a9dc76", "#78dce8", "#ab9df2"] },
  { id: "classic", dot: "#a6e22e", name: "Classic", sub: "The original dark", bg: "#272822", border: "#3b3a32", fg: "#fdfff1", accent: "#f92672", on: "#272822", sw: ["#f92672", "#fd971f", "#e6db74", "#a6e22e", "#66d9ef", "#ae81ff"] },
  { id: "octagon", dot: "#9cd1bb", name: "Octagon", sub: "Cool indigo", bg: "#282a3a", border: "#3a3d4b", fg: "#eaf2f1", accent: "#ff657a", on: "#282a3a", sw: ["#ff657a", "#ff9b5e", "#ffd76d", "#bad761", "#9cd1bb", "#c39ac9"] },
  { id: "machine", dot: "#7cd5f1", name: "Machine", sub: "Teal graphite", bg: "#273136", border: "#3a464b", fg: "#f2fffc", accent: "#ff6d7e", on: "#273136", sw: ["#ff6d7e", "#ffb270", "#ffed72", "#a2e57b", "#7cd5f1", "#baa0f8"] },
  { id: "ristretto", dot: "#f9cc6c", name: "Ristretto", sub: "Espresso brown", bg: "#2c2525", border: "#403838", fg: "#fff1f3", accent: "#fd6883", on: "#2c2525", sw: ["#fd6883", "#f38d70", "#f9cc6c", "#adda78", "#85dacc", "#a8a9eb"] },
  { id: "spectrum", dot: "#948ae3", name: "Spectrum", sub: "Neutral black", bg: "#222222", border: "#363636", fg: "#f7f1ff", accent: "#fc618d", on: "#222222", sw: ["#fc618d", "#fd9353", "#fce566", "#7bd88f", "#5ad4e6", "#948ae3"] },
];

/** Shown on the page and emitted as FAQPage structured data (answers as plain text). */
const FAQ = [
  {
    q: "Is Sarala really free?",
    a: [`Yes. Sarala is free and open source under the GPL-3.0 license. There is no paid tier, no account and no trial.`],
  },
  {
    q: "How is Sarala different from other Markdown editors?",
    a: [
      `Most editors show raw Markdown on one side and a preview on the other. Sarala renders each block in place as you type, so you read and edit the same page. Click a paragraph to see its Markdown, click away to see it rendered.`,
      `If you know Typora, the idea is similar, but Sarala is free, open source, and adds Mermaid and D2 diagrams, an AI assistant and offline voice typing.`,
    ],
  },
  {
    q: "Are my documents locked into a special format?",
    a: [`No. Sarala reads and writes plain .md files in folders you choose. Open them in any editor, keep them in Git, or sync them with any service.`],
  },
  {
    q: "Does Sarala collect data or need the internet?",
    a: [`Sarala has no telemetry and no account. It only goes online to check for updates, to load images your documents link to, and to download the speech model if you turn on voice typing.`],
  },
  {
    q: "How does the AI assistant work? Do I need an API key?",
    a: [`No key is needed. Sarala uses the Claude Code, OpenAI Codex or GitHub Copilot command-line tool already installed and signed in on your computer. Their edits arrive as changes you accept or reject, and Sarala stores no keys.`],
  },
  {
    q: "Which platforms does Sarala run on?",
    a: [`macOS (one build for Apple Silicon and Intel), Windows 10 and 11, and Linux as an AppImage, .deb, .rpm or Snap.`],
  },
];
const faqLd = {
  "@type": "FAQPage",
  mainEntity: FAQ.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.join(" ") },
  })),
};
---

<Layout extraLd={[faqLd]}>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="/" aria-label="Sarala home">
        <img src="/assets/icon-64.png" alt="" width="30" height="30" />
        Sarala
      </a>
      <nav class="nav-links" aria-label="Main">
        <a href="#features">Features</a>
        <a href="#ai">AI &amp; voice</a>
        <a href="#themes">Themes</a>
        <a href="#faq">FAQ</a>
      </nav>
      <div class="nav-end">
        <span class="swatches nav-swatches" role="group" aria-label="Theme">
          {THEMES.map((t) => (
            <button type="button" class="swatch" data-set-theme={t.id} style={`background:${t.dot}`} aria-label={`${t.name} theme`} aria-pressed="false"></button>
          ))}
        </span>
        <a class="nav-gh" href={GITHUB} target="_blank" rel="noopener" aria-label="Sarala on GitHub" set:html={svg("github")} />
        <a class="btn btn-primary nav-cta" href="#download">Download</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true">
        <div class="hero-grid"></div>
        <div class="hero-glyphs" id="hero-glyphs"></div>
      </div>
      <div class="wrap">
        <div class="hero-mark">
          <img src="/assets/icon-256.png" alt="" width="116" height="116" fetchpriority="high" />
        </div>
        <a class="eyebrow" href="#ai"><span class="pip" aria-hidden="true"></span><span class="eb-lead">free &amp; open source · v{VERSION} ·</span> <b>new: AI assistant &amp; voice typing</b></a>
        <h1 id="hero-title">Markdown that reads like a <span class="grad">finished&nbsp;document.</span></h1>
        <p class="hero-sub">
          Sarala is a free, open-source WYSIWYG Markdown editor for macOS, Windows and Linux. Write plain Markdown and
          see the finished document on the same page, with no preview pane and no split view.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" id="hero-dl" href="#download"><Fragment set:html={svg("download", "ico")} /><span>Download free</span></a>
          <a class="btn btn-ghost" href={GITHUB} target="_blank" rel="noopener"><Fragment set:html={svg("github", "ico")} />View on GitHub</a>
        </div>
        <ul class="hero-meta">
          <li><Fragment set:html={svg("check")} />Free and open source</li>
          <li><Fragment set:html={svg("check")} />No account, no telemetry</li>
          <li><Fragment set:html={svg("check")} />Plain .md files</li>
          <li><Fragment set:html={svg("check")} />Version {VERSION}</li>
        </ul>

        <!-- A live replica of the app window: the Live / Source switch and the
             theme swatches below it work, everything else is a picture. -->
        <figure class="demo">
          <div class="app" id="demo-app" data-mode="live">
            <aside class="app-side" aria-hidden="true">
              <span class="lights"><i></i><i></i><i></i></span>
              <div class="side-head"><span class="ic" set:html={svg("folder")} />notes<span class="sp"></span><span class="ic" set:html={svg("openfolder")} /><span class="ic" set:html={svg("newfile")} /></div>
              <div class="side-tabs"><span class="on" set:html={svg("files") + "Files"} /><span set:html={svg("outline") + "Outline"} /><span set:html={svg("search") + "Find"} /></div>
              <div class="side-group"><span set:html={svg("chevD")} />Recent<span class="sp"></span><span set:html={svg("trash")} /></div>
              <div class="side-item on"><Fragment set:html={svg("file")} />Welcome to Sarala.md<small>notes</small></div>
              <div class="side-group"><span>All files</span><span class="sp"></span><span set:html={svg("refresh")} /><span set:html={svg("collapse")} /></div>
              <div class="side-filter"><Fragment set:html={svg("search")} />Filter files…</div>
              <div class="side-item"><Fragment set:html={svg("chevR") + svg("folder")} />Kafka</div>
              <div class="side-item"><Fragment set:html={svg("chevD") + svg("folder")} />Kubernetes</div>
              <div class="side-item l2"><Fragment set:html={svg("file")} />Cluster Architecture.md</div>
              <div class="side-item l2"><Fragment set:html={svg("file")} />Zero-downtime Deploys.md</div>
              <div class="side-item"><Fragment set:html={svg("chevR") + svg("folder")} />Notes</div>
              <div class="side-item on"><Fragment set:html={svg("file")} />Welcome to Sarala.md</div>
            </aside>

            <div class="app-main">
              <div class="app-top">
                <span class="ic hide-sm" aria-hidden="true" set:html={svg("sidebar")} />
                <span class="app-tab" aria-hidden="true">Welcome to Sarala.md<Fragment set:html={svg("close")} /></span>
                <span class="ic hide-sm" aria-hidden="true" set:html={svg("plus")} />
                <span class="sp"></span>
                <span class="app-search" aria-hidden="true"><Fragment set:html={svg("search")} />Search commands…<kbd>⌘K</kbd></span>
                <span class="ic hide-sm" aria-hidden="true" set:html={svg("mic")} />
                <span class="ic hide-sm" aria-hidden="true" set:html={svg("focus")} />
                <span class="seg" role="group" aria-label="Editor view">
                  <button type="button" data-demo-mode="live" aria-pressed="true">Live</button>
                  <button type="button" data-demo-mode="source" aria-pressed="false">Source</button>
                </span>
              </div>

              <div class="app-doc">
                <div class="rendered">
                  <h3 class="d1">Welcome to Sarala</h3>
                  <p>Sarala renders Markdown <b>as you type</b>. There is no preview pane: the page you write <em>is</em> the page you read. Click any paragraph to see its source.</p>
                  <div class="callout"><b>Tip</b>Press <kbd>⌘</kbd> <kbd>K</kbd> for the command palette, or type <code>/</code> on an empty line to insert a table, a diagram or an equation.</div>
                  <h4 class="d2">Everything in one plain-text file</h4>
                  <table>
                    <thead><tr><th>Feature</th><th>You type</th><th>You see</th></tr></thead>
                    <tbody>
                      <tr><td>Emphasis</td><td><code>**bold**</code>, <code>==highlight==</code></td><td><b>bold</b>, <mark>highlight</mark></td></tr>
                      <tr><td>Math</td><td><code>$E = mc^2$</code></td><td><span class="math">E = mc²</span></td></tr>
                      <tr><td>Tasks</td><td><code>- [ ] ship it</code></td><td>Clickable checkboxes</td></tr>
                    </tbody>
                  </table>
                  <h4 class="d2">This week</h4>
                  <ul>
                    <li><span class="cb on" set:html={svg("check")} />Draft the Kafka migration plan</li>
                    <li><span class="cb on" set:html={svg("check")} />Review the Kubernetes rollout runbook</li>
                    <li><span class="cb"></span>Load-test the new consumer group 🚀</li>
                  </ul>
                </div>
<pre class="source"><span class="mk"># </span>Welcome to Sarala

Sarala renders Markdown <span class="mk">**</span>as you type<span class="mk">**</span>. There is no preview pane: the page you write <span class="mk">*</span>is<span class="mk">*</span> the page you read. Click any paragraph to see its source.

<span class="mk">&gt; [!TIP]</span>
<span class="mk">&gt;</span> Press <span class="cd">&lt;kbd&gt;⌘&lt;/kbd&gt;</span> <span class="cd">&lt;kbd&gt;K&lt;/kbd&gt;</span> for the command palette, or type <span class="cd">`/`</span> on an empty line to insert a table, a diagram or an equation.

<span class="mk">## </span>Everything in one plain-text file

