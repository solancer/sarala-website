---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found · Sarala" description="This page doesn't exist." path="/404" noindex>
  <main id="main" class="section" style="text-align:center;min-height:70vh;display:grid;place-items:center">
    <div class="wrap sec-head center">
      <span class="kicker">404</span>
      <h1 style="font-size:clamp(34px,6vw,56px);letter-spacing:-.03em;margin-top:12px">This page doesn't exist</h1>
      <p>The link may be old or mistyped.</p>
      <p style="margin-top:28px"><a class="btn btn-primary" href="/">Go to the Sarala home page</a></p>
    </div>
  </main>
</Layout>
